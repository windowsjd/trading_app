que @map(\"trading_account_id\")\n  endAt               DateTime             @map(\"end_at\")\n  feeRate             Decimal              @map(\"fee_rate\") @db.Decimal(10, 6)\n  realizedPnl         Decimal              @map(\"realized_pnl\") @db.Decimal(24, 8)\n  feeAmount           Decimal              @map(\"fee_amount\") @db.Decimal(24, 8)\n  settledPnl          Decimal              @map(\"settled_pnl\") @db.Decimal(24, 8)\n  settledFee          Decimal              @map(\"settled_fee\") @db.Decimal(24, 8)\n  settledCash         Decimal              @map(\"settled_cash\") @db.Decimal(24, 8)\n  bankruptcyShortfall Decimal              @map(\"bankruptcy_shortfall\") @db.Decimal(24, 8)\n  walletBalanceBefore Decimal              @map(\"wallet_balance_before\") @db.Decimal(24, 8)\n  walletBalanceAfter  Decimal              @map(\"wallet_balance_after\") @db.Decimal(24, 8)\n  /// Original collateral, economic result, actual cash and shortfall per scope.\n  scopesJson          Json                 @map(\"scopes_json\")\n  executedAt          DateTime             @map(\"executed_at\")\n  season              Season               @relation(fields: [seasonId], references: [id], onDelete: Restrict)\n  tradingAccount      TradingAccount       @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  closes              FuturesSeasonClose[]\n\n  @@unique([id, tradingAccountId])\n  @@index([seasonId])\n  @@map(\"futures_season_settlements\")\n}\n\nmodel FuturesSeasonClose {\n  id               String                  @id @default(uuid())\n  settlementId     String                  @map(\"settlement_id\")\n  tradingAccountId String                  @map(\"trading_account_id\")\n  positionId       String                  @unique @map(\"position_id\")\n  instrumentId     String                  @map(\"instrument_id\")\n  priceId          String                  @map(\"price_id\")\n  direction        FuturesDirection\n  marginMode       FuturesMarginMode     