erBadges                  UserBadge[]\n  seasonRewards               SeasonReward[]\n  operatorAuditLogs           OperatorAuditLog[]\n  quotes                      Quote[]\n  adRewardClaims              AdRewardClaim[]\n  rewardFulfillmentTargets    RewardFulfillmentRequest[] @relation(\"RewardFulfillmentTargetUser\")\n  rewardFulfillmentsRequested RewardFulfillmentRequest[] @relation(\"RewardFulfillmentRequestedBy\")\n  rewardFulfillmentsProcessed RewardFulfillmentRequest[] @relation(\"RewardFulfillmentProcessedBy\")\n  rewardFulfillmentsCanceled  RewardFulfillmentRequest[] @relation(\"RewardFulfillmentCanceledBy\")\n\n  @@map(\"users\")\n}\n\nenum FriendshipStatus {\n  pending\n  accepted\n}\n\nmodel Friendship {\n  id              String           @id @default(uuid())\n  lowUserId       String           @map(\"low_user_id\")\n  highUserId      String           @map(\"high_user_id\")\n  requesterUserId String           @map(\"requester_user_id\")\n  status          FriendshipStatus @default(pending)\n  createdAt       DateTime         @default(now()) @map(\"created_at\")\n  lowUser         User             @relation(\"FriendshipLow\", fields: [lowUserId], references: [id], onDelete: Restrict)\n  highUser        User             @relation(\"FriendshipHigh\", fields: [highUserId], references: [id], onDelete: Restrict)\n\n  @@unique([lowUserId, highUserId])\n  @@index([lowUserId, status, createdAt, id])\n  @@index([highUserId, status, createdAt, id])\n  @@map(\"friendships\")\n}\n\nmodel OperatorAuditLog {\n  id           String              @id @default(uuid())\n  actorUserId  String              @map(\"actor_user_id\")\n  actorRole    UserRole            @map(\"actor_role\")\n  action       String\n  targetType   String?             @map(\"target_type\")\n  targetId     String?             @map(\"target_id\")\n  requestId    String?             @map(\"request_id\")\n  ipAddress    String?             @map(\"ip_address\")\n  userAgent    String?             @map(\"