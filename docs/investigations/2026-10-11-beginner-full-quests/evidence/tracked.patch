e_at\")\n  capturedAt      DateTime                  @map(\"captured_at\")\n  instrument      FuturesInstrument         @relation(fields: [instrumentId], references: [id], onDelete: Restrict)\n  closes          FuturesLiquidationClose[]\n\n  @@unique([instrumentId, source, effectiveAt])\n  @@index([instrumentId, effectiveAt])\n  @@index([capturedAt, id])\n  @@map(\"futures_mark_snapshots\")\n}\n\nmodel FuturesLiquidation {\n  id                     String                    @id @default(uuid())\n  tradingAccountId       String                    @map(\"trading_account_id\")\n  marginMode             FuturesMarginMode         @map(\"margin_mode\")\n  evaluationAt           DateTime                  @map(\"evaluation_at\")\n  collateralAvailable    Decimal                   @map(\"collateral_available\") @db.Decimal(24, 8)\n  preEquity              Decimal                   @map(\"pre_equity\") @db.Decimal(24, 8)\n  maintenanceMargin      Decimal                   @map(\"maintenance_margin\") @db.Decimal(24, 8)\n  estimatedCloseFee      Decimal                   @map(\"estimated_close_fee\") @db.Decimal(24, 8)\n  liquidationRequirement Decimal                   @map(\"liquidation_requirement\") @db.Decimal(24, 8)\n  realizedPnl            Decimal                   @map(\"realized_pnl\") @db.Decimal(24, 8)\n  feeAmount              Decimal                   @map(\"fee_amount\") @db.Decimal(24, 8)\n  settledPnl             Decimal                   @map(\"settled_pnl\") @db.Decimal(24, 8)\n  settledFee             Decimal                   @map(\"settled_fee\") @db.Decimal(24, 8)\n  settledCash            Decimal                   @map(\"settled_cash\") @db.Decimal(24, 8)\n  bankruptcyShortfall    Decimal                   @map(\"bankruptcy_shortfall\") @db.Decimal(24, 8)\n  walletBalanceBefore    Decimal                   @map(\"wallet_balance_before\") @db.Decimal(24, 8)\n  walletBalanceAfter     Decimal                   @map(\"wallet_balance_after\") @db.Decimal(24,