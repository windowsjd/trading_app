on participant has\n  // exactly one season-mode TradingAccount; season state remains here while\n  // wallets/orders/positions/FX/snapshots are owned by that account.\n  tradingAccountId        String            @unique @map(\"trading_account_id\")\n  createdAt               DateTime          @default(now()) @map(\"created_at\")\n  updatedAt               DateTime          @updatedAt @map(\"updated_at\")\n\n  season                    Season                     @relation(fields: [seasonId], references: [id], onDelete: Cascade)\n  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)\n  tradingAccount            TradingAccount             @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  seasonRankings            SeasonRanking[]\n  seasonRewards             SeasonReward[]\n  rewardFulfillmentRequests RewardFulfillmentRequest[]\n\n  @@unique([seasonId, userId])\n  @@index([seasonId])\n  @@index([seasonId, participantStatus])\n  @@index([seasonId, rankingHiddenAt])\n  @@index([userId])\n  @@map(\"season_participants\")\n}\n\nmodel Badge {\n  id          String    @id @default(uuid())\n  badgeType   BadgeType @map(\"badge_type\")\n  code        String    @unique\n  name        String\n  description String?\n  iconUrl     String?   @map(\"icon_url\")\n  createdAt   DateTime  @default(now()) @map(\"created_at\")\n  updatedAt   DateTime  @updatedAt @map(\"updated_at\")\n\n  userBadges UserBadge[]\n\n  @@index([badgeType])\n  @@map(\"badges\")\n}\n\nmodel UserBadge {\n  id        String   @id @default(uuid())\n  userId    String   @map(\"user_id\")\n  badgeId   String   @map(\"badge_id\")\n  seasonId  String   @map(\"season_id\")\n  awardedAt DateTime @map(\"awarded_at\")\n  createdAt DateTime @default(now()) @map(\"created_at\")\n\n  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)\n  badge  Badge  @relation(fields: [badgeId], references: [id], onDelete: Restrict)\n  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, badgeId, seasonId])\n  @@index([userId, awardedAt])\n  @@index([badgeId])\n  @@index([seasonId])\n  @@map(\"user_badges\")\n}\n\nmodel SeasonReward {\n  id                   String           @id @default(uuid())\n  seasonId             String           @map(\"season_id\")\n  seasonParticipantId  String           @map(\"season_participant_id\")\n  userId               String           @map(\"user_id\")\n  rewardType           SeasonRewardType @map(\"reward_type\")\n  rewardCode           String           @map(\"reward_code\")\n  rewardName           String           @map(\"reward_name\")\n  rewardValueJson      Json?            @map(\"reward_value_json\")\n  fulfillmentRequestId String?          @unique @map(\"fulfillment_request_id\")\n  grantedAt            DateTime         @map(\"granted_at\")\n  createdAt            DateTime         @default(now()) @map(\"created_at\")\n\n  season                    Season                     @relation(fields: [seasonId], references: [id], onDelete: Restrict)\n  seasonParticipant         SeasonParticipant          @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)\n  user                      User                       @relation(fields: [userId], references: [id], onDelete: Restrict)\n  fulfillmentRequest        RewardFulfillmentRequest?  @relation(\"SeasonRewardFulfillmentRequest\", fields: [fulfillmentRequestId], references: [id], onDelete: SetNull)\n  rewardFulfillmentRequests RewardFulfillmentRequest[] @relation(\"RewardFulfillmentRequestSeasonReward\")\n\n  @@unique([seasonParticipantId, rewardCode])\n  @@index([seasonId, grantedAt])\n  @@index([userId, grantedAt])\n  @@index([rewardType, rewardCode])\n  @@index([fulfillmentRequestId])\n  @@map(\"season_rewards\")\n}\n\nmodel RewardFulfillmentRequest {\n  id                  String                  @id @default(uuid())\n  seasonId            String                  @map(\"season_id\")\n  seasonParticipantId String                  @map(\"season_participant_id\")\n  userId              String                  @map(\"user_id\")\n  rewardType          SeasonRewardType        @map(\"reward_type\")\n  rewardCode          String                  @map(\"reward_code\")\n  rewardName          String                  @map(\"reward_name\")\n  rewardValueJson     Json?                   @map(\"reward_value_json\")\n  status              RewardFulfillmentStatus @default(pending)\n  seasonRewardId      String?                 @map(\"season_reward_id\")\n  idempotencyKey      String                  @map(\"idempotency_key\")\n  requestHash         String                  @map(\"request_hash\")\n  requestedByUserId   String                  @map(\"requested_by_user_id\")\n  processedByUserId   String?                 @map(\"processed_by_user_id\")\n  canceledByUserId    String?                 @map(\"canceled_by_user_id\")\n  requestedAt         DateTime                @default(now()) @map(\"requested_at\")\n  processingStartedAt DateTime?               @map(\"processing_started_at\")\n  fulfilledAt         DateTime?               @map(\"fulfilled_at\")\n  failedAt            DateTime?               @map(\"failed_at\")\n  canceledAt          DateTime?               @map(\"canceled_at\")\n  errorCode           String?                 @map(\"error_code\")\n  errorMessage        String?                 @map(\"error_message\")\n  createdAt           DateTime                @default(now()) @map(\"created_at\")\n  updatedAt           DateTime                @updatedAt @map(\"updated_at\")\n\n  season            Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)\n  seasonParticipant SeasonParticipant @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)\n  user              User              @relation(\"RewardFulfillmentTargetUser\", fields: [userId], references: [id], onDelete: Restrict)\n  seasonReward      SeasonReward?     @relation(\"RewardFulfillmentRequestSeasonReward\", fields: [seasonRewardId], references: [id], onDelete: SetNull)\n  requestedBy       User              @relation(\"RewardFulfillmentRequestedBy\", fields: [requestedByUserId], references: [id], onDelete: Restrict)\n  processedBy       User?             @relation(\"RewardFulfillmentProcessedBy\", fields: [processedByUserId], references: [id], onDelete: SetNull)\n  canceledBy        User?             @relation(\"RewardFulfillmentCanceledBy\", fields: [canceledByUserId], references: [id], onDelete: SetNull)\n  seasonRewards     SeasonReward[]    @relation(\"SeasonRewardFulfillmentRequest\")\n\n  @@unique([requestedByUserId, idempotencyKey])\n  @@unique([seasonParticipantId, rewardCode])\n  @@index([seasonId, status])\n  @@index([userId, status])\n  @@index([status, createdAt])\n  @@index([seasonRewardId])\n  @@index([requestedByUserId, requestedAt])\n  @@map(\"reward_fulfillment_requests\")\n}\n\nmodel Asset {\n  id                 String       @id @default(uuid())\n  symbol             String\n  name               String\n  market             String\n  currencyCode       CurrencyCode @map(\"currency_code\")\n  priceCurrency      CurrencyCode @default(KRW) @map(\"price_currency\")\n  settlementCurrency CurrencyCode @default(KRW) @map(\"settlement_currency\")\n  assetType          AssetType    @map(\"asset_type\")\n  isActive           Boolean      @default(true) @map(\"is_active\")\n  createdAt          DateTime     @default(now()) @map(\"created_at\")\n  updatedAt          DateTime     @updatedAt @map(\"updated_at\")\n\n  priceSnapshots           AssetPriceSnapshot[]\n  orderbookSnapshots       AssetOrderbookSnapshot[]\n  marketCandles            MarketCandle[]\n  marketCandleSyncStates   MarketCandleSyncState[]\n  positions                Position[]\n  orders                   Order[]\n  quotes                   Quote[]\n  limitOrderCandleEvidence LimitOrderCandleEvidence[]\n  futuresInstruments       FuturesInstrument[]\n  protectionGroups         ProtectionGroup[]\n\n  @@unique([market, symbol])\n  @@index([assetType, market])\n  @@index([isActive])\n  @@map(\"assets\")\n}\n\nmodel AssetPriceSnapshot {\n  id              String               @id @default(uuid())\n  assetId         String               @map(\"asset_id\")\n  price           Decimal              @db.Decimal(24, 8)\n  priceKrw        Decimal?             @map(\"price_krw\") @db.Decimal(24, 8)\n  currencyCode    CurrencyCode         @map(\"currency_code\")\n  sourceType      AssetPriceSourceType @map(\"source_type\")\n  sourceName      String?              @map(\"source_name\")\n  sourceTimestamp DateTime?            @map(\"source_timestamp\")\n  effectiveAt     DateTime             @map(\"effective_at\")\n  capturedAt      DateTime             @map(\"captured_at\")\n  createdAt       DateTime             @default(now()) @map(\"created_at\")\n  rawPayloadJson  Json?                @map(\"raw_payload_json\")\n  note            String?\n\n  asset               Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)\n  orders              Order[]\n  quotes              Quote[]\n  futuresExecutions   FuturesExecution[]\n  futuresSeasonPrices FuturesSeasonPrice[]\n  protectionChildren  ProtectionChild[]\n\n  @@index([assetId, effectiveAt])\n  @@index([assetId, capturedAt])\n  @@index([sourceType, effectiveAt])\n  @@map(\"asset_price_snapshots\")\n}\n\nmodel AssetOrderbookSnapshot {\n  id             String               @id @default(uuid())\n  assetId        String               @map(\"asset_id\")\n  sourceType     AssetPriceSourceType @map(\"source_type\")\n  sourceName     String               @map(\"source_name\")\n  bidPrice       Decimal              @map(\"bid_price\") @db.Decimal(24, 8)\n  bidQuantity    Decimal?             @map(\"bid_quantity\") @db.Decimal(24, 8)\n  askPrice       Decimal              @map(\"ask_price\") @db.Decimal(24, 8)\n  askQuantity    Decimal?             @map(\"ask_quantity\") @db.Decimal(24, 8)\n  spreadBps      Decimal?             @map(\"spread_bps\") @db.Decimal(18, 8)\n  currencyCode   CurrencyCode         @map(\"currency_code\")\n  effectiveAt    DateTime             @map(\"effective_at\")\n  capturedAt     DateTime             @map(\"captured_at\")\n  rawPayloadJson Json?                @map(\"raw_payload_json\")\n  createdAt      DateTime             @default(now()) @map(\"created_at\")\n\n  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)\n\n  @@index([assetId, sourceName, effectiveAt])\n  @@index([assetId, capturedAt])\n  @@index([sourceType, effectiveAt])\n  @@map(\"asset_orderbook_snapshots\")\n}\n\nmodel MarketCandle {\n  id              String   @id @default(uuid())\n  assetId         String   @map(\"asset_id\")\n  // Stored as a plain string instead of a Prisma enum: API interval literals\n  // (\"5m\", \"1d\", \"1w\") start with a digit and cannot be enum identifiers, and\n  // later aggregation intervals (15m/30m/1h/4h) must be addable without an\n  // ALTER TYPE migration. The allowlist is enforced by MarketCandlesRepository.\n  interval        String\n  // Candle window is [openTime, closeTime); both are UTC instants.\n  openTime        DateTime @map(\"open_time\") @db.Timestamptz(3)\n  closeTime       DateTime @map(\"close_time\") @db.Timestamptz(3)\n  open            Decimal  @db.Decimal(24, 8)\n  high            Decimal  @db.Decimal(24, 8)\n  low             Decimal  @db.Decimal(24, 8)\n  close           Decimal  @db.Decimal(24, 8)\n  volume          Decimal  @db.Decimal(24, 8)\n  amount          Decimal? @db.Decimal(24, 8)\n  isClosed        Boolean  @map(\"is_closed\")\n  sourceProvider  String   @map(\"source_provider\")\n  sourceUpdatedAt DateTime @map(\"source_updated_at\") @db.Timestamptz(3)\n  createdAt       DateTime @default(now()) @map(\"created_at\") @db.Timestamptz(3)\n  updatedAt       DateTime @updatedAt @map(\"updated_at\") @db.Timestamptz(3)\n\n  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)\n\n  @@unique([assetId, interval, openTime])\n  @@index([interval, openTime])\n  @@index([isClosed, openTime])\n  // Path-B candidate scan: closed 5m rows of one asset ordered by window start.\n  @@index([assetId, interval, isClosed, openTime])\n  @@map(\"market_candles\")\n}\n\n// Persistent checkpoint for one candle sync run of a single asset/feed.\n// `feed` is the stored interval literal (\"5m\", \"1d\", \"1w\") — a string for the\n// same reason MarketCandle.interval is. cursorJson holds only provider-neutral\n// resume state (dates/epoch cursors); credentials and raw provider payloads\n// must never be stored here. Active-run uniqueness (at most one pending or\n// running row per asset/feed) is enforced by a partial unique index that\n// Prisma cannot express; see the migration SQL\n// (market_candle_sync_states_active_unique).\nmodel MarketCandleSyncState {\n  id                   String                 @id @default(uuid())\n  assetId              String                 @map(\"asset_id\")\n  feed                 String\n  sourceProvider       String                 @map(\"source_provider\")\n  mode                 MarketCandleSyncMode\n  status               MarketCandleSyncStatus @default(pending)\n  // Target candle range, half-open [targetFrom, targetTo), UTC instants.\n  targetFrom           DateTime               @map(\"target_from\") @db.Timestamptz(3)\n  targetTo             DateTime               @map(\"target_to\") @db.Timestamptz(3)\n  cursorJson           Json?                  @map(\"cursor_json\")\n  pagesFetched         Int                    @default(0) @map(\"pages_fetched\")\n  providerRowsReceived Int                    @default(0) @map(\"provider_rows_received\")\n  rowsAccepted         Int                    @default(0) @map(\"rows_accepted\")\n  rowsRejected         Int                    @default(0) @map(\"rows_rejected\")\n  rowsDuplicated       Int                    @default(0) @map(\"rows_duplicated\")\n  rowsWritten          Int                    @default(0) @map(\"rows_written\")\n  lastSuccessfulPageAt DateTime?              @map(\"last_successful_page_at\") @db.Timestamptz(3)\n  completedAt          DateTime?              @map(\"completed_at\") @db.Timestamptz(3)\n  // Coverage completeness is independent of `status`: `completed` records that\n  // the run terminated normally, while coverageComplete=true additionally\n  // asserts that the provider cursor confirmed the entire half-open\n  // [targetFrom, targetTo) range. Rows created before this column existed keep\n  // coverageComplete=false and are never used as serving coverage evidence.\n  coverageComplete     Boolean                @default(false) @map(\"coverage_complete\")\n  completionReason     String?                @map(\"completion_reason\")\n  // Half-open [coveredFrom, coveredTo) instants actually confirmed by the\n  // provider cursor so far (grows monotonically while the run pages).\n  coveredFrom          DateTime?              @map(\"covered_from\") @db.Timestamptz(3)\n  coveredTo            DateTime?              @map(\"covered_to\") @db.Timestamptz(3)\n  errorCode            String?                @map(\"error_code\")\n  errorMessage         String?                @map(\"error_message\")\n  createdAt            DateTime               @default(now()) @map(\"created_at\") @db.Timestamptz(3)\n  updatedAt            DateTime               @updatedAt @map(\"updated_at\") @db.Timestamptz(3)\n\n  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)\n\n  @@index([assetId, feed, status])\n  @@index([status, updatedAt])\n  @@map(\"market_candle_sync_states\")\n}\n\n// Operator-managed exception layer over the static per-year market calendar\n// datasets (backend/src/orders/market-calendar/data). localDate is the\n// exchange's local trading date (KRX: Asia/Seoul, US: America/New_York)\n// stored as YYYY-MM-DD text so the exchange-local meaning never shifts with\n// server/DB time zones; openTime/closeTime are exchange-local HHmmss text in\n// the same canonical format the static datasets use. `regular` cancels a\n// static closure/session override and forces the default session; `closed`\n// forces a full-day closure; `custom` sets explicit open/close times (both\n// required, open < close — enforced by CHECK constraints in the migration).\n// An override never grants calendar coverage for its year: dates in years\n// without a static dataset stay fail-closed (calendar_unavailable). Rows are\n// deactivated (isActive=false) instead of deleted to preserve operational\n// history.\nmodel MarketSessionOverride {\n  id              String                    @id @default(uuid())\n  market          MarketCalendarMarket\n  localDate       String                    @map(\"local_date\")\n  overrideType    MarketSessionOverrideType @map(\"override_type\")\n  openTime        String?                   @map(\"open_time\")\n  closeTime       String?                   @map(\"close_time\")\n  reason          String\n  source          String?\n  isActive        Boolean                   @default(true) @map(\"is_active\")\n  createdByUserId String                    @map(\"created_by_user_id\")\n  updatedByUserId String                    @map(\"updated_by_user_id\")\n  createdAt       DateTime                  @default(now()) @map(\"created_at\")\n  updatedAt       DateTime                  @updatedAt @map(\"updated_at\")\n\n  @@unique([market, localDate])\n  @@index([isActive, market, localDate])\n  @@index([localDate])\n  @@map(\"market_session_overrides\")\n}\n\n// Asset remains the Spot underlying. Product identity is never inferred from symbol.\nmodel FuturesInstrument {\n  id                 String             @id @default(uuid())\n  underlyingAssetId  String             @map(\"underlying_asset_id\")\n  productType        FuturesProductType @default(synthetic_perpetual) @map(\"product_type\")\n  settlementCurrency CurrencyCode       @default(USD) @map(\"settlement_currency\")\n  isActive           Boolean            @default(true) @map(\"is_active\")\n  /// Exact public USDⓈ-M PERPETUAL contract verification. Null means unverified.\n  markContractJson   Json?              @map(\"mark_contract_json\")\n  markVerifiedAt     DateTime?          @map(\"mark_verified_at\")\n  createdAt          DateTime           @default(now()) @map(\"created_at\")\n  updatedAt          DateTime           @updatedAt @map(\"updated_at\")\n\n  underlyingAsset   Asset                      @relation(fields: [underlyingAssetId], references: [id], onDelete: Restrict)\n  positions         FuturesPosition[]\n  executions        FuturesExecution[]\n  marks             FuturesMarkSnapshot[]\n  lastPrices        FuturesLastPriceSnapshot[]\n  liquidationCloses FuturesLiquidationClose[]\n  seasonPrices      FuturesSeasonPrice[]\n  seasonCloses      FuturesSeasonClose[]\n  limitOrders       FuturesLimitOrder[]\n\n  @@unique([underlyingAssetId, productType, settlementCurrency])\n  @@map(\"futures_instruments\")\n}\n\n// One row per lifetime. SQL partial unique permits only one OPEN lifetime per\n// account/instrument. Closed rows preserve cumulative realized PnL and identity.\nmodel FuturesPosition {\n  id                String                @id @default(uuid())\n  tradingAccountId  String                @map(\"trading_account_id\")\n  instrumentId      String                @map(\"instrument_id\")\n  direction         FuturesDirection\n  marginMode        FuturesMarginMode     @default(isolated) @map(\"margin_mode\")\n  status            FuturesPositionStatus @default(open)\n  quantity          Decimal               @db.Decimal(24, 8)\n  averageEntryPrice Decimal               @map(\"average_entry_price\") @db.Decimal(24, 8)\n  // Exact entry basis for conservative margin allocation across rounded averages.\n  entryNotional     Decimal               @map(\"entry_notional\") @db.Decimal(40, 16)\n  leverage          Int\n  isolatedMargin    Decimal               @map(\"isolated_margin\") @db.Decimal(24, 8)\n  realizedPnl       Decimal               @default(0) @map(\"realized_pnl\") @db.Decimal(24, 8)\n  closedAt          DateTime?             @map(\"closed_at\")\n  createdAt         DateTime              @default(now()) @map(\"created_at\")\n  updatedAt         DateTime              @updatedAt @map(\"updated_at\")\n\n  tradingAccount   TradingAccount           @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  instrument       FuturesInstrument        @relation(fields: [instrumentId], references: [id], onDelete: Restrict)\n  executions       FuturesExecution[]\n  liquidationClose FuturesLiquidationClose?\n  seasonClose      FuturesSeasonClose?\n  protectionGroups ProtectionGroup[]\n\n  @@unique([id, tradingAccountId, instrumentId])\n  @@index([tradingAccountId, status, instrumentId])\n  @@index([instrumentId])\n  @@map(\"futures_positions\")\n}\n\n// A terminal full-fill event, separate from the Spot order/quote lifecycle.\nmodel FuturesExecution {\n  id                     String               @id @default(uuid())\n  tradingAccountId       String               @map(\"trading_account_id\")\n  instrumentId           String               @map(\"instrument_id\")\n  positionId             String               @map(\"position_id\")\n  operation              FuturesOperation\n  direction              FuturesDirection\n  marginMode             FuturesMarginMode    @default(isolated) @map(\"margin_mode\")\n  quantity               Decimal              @db.Decimal(24, 8)\n  leverage               Int\n  executionPrice         Decimal              @map(\"execution_price\") @db.Decimal(24, 8)\n  /// Legacy Spot evidence of executions committed before Futures Last pricing.\n  /// SQL CHECK: exactly one of assetPriceSnapshotId / lastPriceSnapshotId.\n  assetPriceSnapshotId   String?              @map(\"asset_price_snapshot_id\")\n  lastPriceSnapshotId    String?              @map(\"last_price_snapshot_id\")\n  priceSourceType        AssetPriceSourceType @map(\"price_source_type\")\n  priceSourceName        String               @map(\"price_source_name\")\n  priceEffectiveAt       DateTime             @map(\"price_effective_at\")\n  priceCapturedAt        DateTime             @map(\"price_captured_at\")\n  notional               Decimal              @db.Decimal(24, 8)\n  feeRate                Decimal              @map(\"fee_rate\") @db.Decimal(10, 6)\n  feeAmount              Decimal              @map(\"fee_amount\") @db.Decimal(24, 8)\n  realizedPnl            Decimal              @map(\"realized_pnl\") @db.Decimal(24, 8)\n  positionQuantityAfter  Decimal              @map(\"position_quantity_after\") @db.Decimal(24, 8)\n  averageEntryPriceAfter Decimal              @map(\"average_entry_price_after\") @db.Decimal(24, 8)\n  isolatedMarginAfter    Decimal              @map(\"isolated_margin_after\") @db.Decimal(24, 8)\n  executedAt             DateTime             @map(\"executed_at\")\n  createdAt              DateTime             @default(now()) @map(\"created_at\")\n\n  tradingAccount     TradingAccount            @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  instrument         FuturesInstrument         @relation(fields: [instrumentId], references: [id], onDelete: Restrict)\n  position           FuturesPosition           @relation(fields: [positionId, tradingAccountId, instrumentId], references: [id, tradingAccountId, instrumentId], onDelete: Restrict)\n  assetPriceSnapshot AssetPriceSnapshot?       @relation(fields: [assetPriceSnapshotId], references: [id], onDelete: Restrict)\n  lastPriceSnapshot  FuturesLastPriceSnapshot? @relation(fields: [lastPriceSnapshotId], references: [id], onDelete: Restrict)\n  executeRequest     FuturesExecuteRequest?\n  protectionChild    ProtectionChild?\n  limitOrder         FuturesLimitOrder?\n\n  @@unique([id, tradingAccountId])\n  @@index([tradingAccountId, executedAt, id])\n  @@index([instrumentId])\n  @@index([positionId])\n  @@index([assetPriceSnapshotId])\n  @@index([lastPriceSnapshotId])\n  @@map(\"futures_executions\")\n}\n\n// Only committed commands. Replay returns this exact response, never live state.\nmodel FuturesExecuteRequest {\n  id                  String   @id @default(uuid())\n  tradingAccountId    String   @map(\"trading_account_id\")\n  executionId         String   @unique @map(\"execution_id\")\n  idempotencyKey      String   @map(\"idempotency_key\")\n  requestHash         String   @map(\"request_hash\")\n  responsePayloadJson Json     @map(\"response_payload_json\")\n  executedAt          DateTime @map(\"executed_at\")\n  createdAt           DateTime @default(now()) @map(\"created_at\")\n\n  tradingAccount TradingAccount   @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  execution      FuturesExecution @relation(fields: [executionId, tradingAccountId], references: [id, tradingAccountId], onDelete: Restrict)\n\n  @@unique([tradingAccountId, idempotencyKey])\n  @@unique([executionId, tradingAccountId])\n  @@map(\"futures_execute_requests\")\n}\n\nenum ProtectionDomain {\n  spot\n  futures\n}\n\n// A pending entry reserves collateral, but is never a position or execution.\nmodel FuturesLimitOrder {\n  id                  String            @id @default(uuid())\n  tradingAccountId    String            @map(\"trading_account_id\")\n  instrumentId        String            @map(\"instrument_id\")\n  direction           FuturesDirection\n  marginMode          FuturesMarginMode @map(\"margin_mode\")\n  leverage            Int\n  quantity            Decimal           @db.Decimal(24, 8)\n  limitPrice          Decimal           @map(\"limit_price\") @db.Decimal(24, 8)\n  reservedAmount      Decimal           @map(\"reserved_amount\") @db.Decimal(24, 8)\n  status              OrderStatus       @default(submitted)\n  idempotencyKey      String            @map(\"idempotency_key\")\n  requestHash         String            @map(\"request_hash\")\n  executionId         String?           @unique @map(\"execution_id\")\n  responsePayloadJson Json?             @map(\"response_payload_json\")\n  terminalReason      String?           @map(\"terminal_reason\")\n  createdAt           DateTime          @default(now()) @map(\"created_at\")\n  endedAt             DateTime?         @map(\"ended_at\")\n  updatedAt           DateTime          @updatedAt @map(\"updated_at\")\n\n  tradingAccount TradingAccount    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  instrument     FuturesInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)\n  execution      FuturesExecution? @relation(fields: [executionId, tradingAccountId], references: [id, tradingAccountId], onDelete: Restrict)\n  protection     ProtectionGroup?\n\n  @@unique([executionId, tradingAccountId])\n  @@unique([tradingAccountId, idempotencyKey])\n  @@index([status, id])\n  @@index([tradingAccountId, createdAt, id])\n  @@map(\"futures_limit_orders\")\n}\n\nenum ProtectionStatus {\n  holding\n  active\n  completed\n  canceled\n}\n\nenum ProtectionKind {\n  stop_loss\n  take_profit\n}\n\nenum ProtectionChildStatus {\n  pending\n  filled\n  canceled\n}\n\n// Partial unique indexes enforce one live group per account/product asset and\n// one pending child per group. Legs themselves never reserve position quantity.\nmodel ProtectionGroup {\n  id                   String           @id @default(uuid())\n  tradingAccountId     String           @map(\"trading_account_id\")\n  assetId              String           @map(\"asset_id\")\n  domain               ProtectionDomain\n  direction            FuturesDirection\n  positionId           String?          @map(\"position_id\")\n  futuresPositionId    String?          @map(\"futures_position_id\")\n  parentOrderId        String?          @unique @map(\"parent_order_id\")\n  parentFuturesOrderId String?          @unique @map(\"parent_futures_order_id\")\n  status               ProtectionStatus\n  terminalReason       String?          @map(\"terminal_reason\")\n  createdAt            DateTime         @default(now()) @map(\"created_at\")\n  activatedAt          DateTime?        @map(\"activated_at\")\n  endedAt              DateTime?        @map(\"ended_at\")\n  updatedAt            DateTime         @updatedAt @map(\"updated_at\")\n\n  tradingAccount     TradingAccount     @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  asset              Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)\n  position           Position?          @relation(fields: [positionId], references: [id], onDelete: Restrict)\n  futuresPosition    FuturesPosition?   @relation(fields: [futuresPositionId], references: [id], onDelete: Restrict)\n  parentOrder        Order?             @relation(fields: [parentOrderId], references: [id], onDelete: Restrict)\n  parentFuturesOrder FuturesLimitOrder? @relation(fields: [parentFuturesOrderId], references: [id], onDelete: Restrict)\n  legs               ProtectionLeg[]\n  children           ProtectionChild[]\n\n  @@index([status, id])\n  @@index([tradingAccountId, createdAt, id])\n  @@index([futuresPositionId])\n  @@index([positionId])\n  @@map(\"protection_groups\")\n}\n\nmodel ProtectionLeg {\n  id              String            @id @default(uuid())\n  groupId         String            @map(\"group_id\")\n  kind            ProtectionKind\n  triggerPrice    Decimal           @map(\"trigger_price\") @db.Decimal(24, 8)\n  childOrderType  OrderType         @map(\"child_order_type\")\n  childLimitPrice Decimal?          @map(\"child_limit_price\") @db.Decimal(24, 8)\n  group           ProtectionGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)\n  children        ProtectionChild[]\n\n  @@unique([groupId, kind])\n  @@unique([id, groupId])\n  @@map(\"protection_legs\")\n}\n\nmodel ProtectionChild {\n  id                         String                @id @default(uuid())\n  groupId                    String                @map(\"group_id\")\n  legId                      String                @map(\"leg_id\")\n  status                     ProtectionChildStatus @default(pending)\n  quantity                   Decimal               @db.Decimal(24, 8)\n  orderId                    String?               @unique @map(\"order_id\")\n  futuresExecutionId         String?               @unique @map(\"futures_execution_id\")\n  /// Spot triggers (and Futures triggers recorded before Futures Last pricing).\n  /// SQL CHECK: exactly one of assetPriceSnapshotId / futuresLastPriceSnapshotId.\n  assetPriceSnapshotId       String?               @map(\"asset_price_snapshot_id\")\n  futuresLastPriceSnapshotId String?               @map(\"futures_last_price_snapshot_id\")\n  triggerEvidenceJson        Json                  @map(\"trigger_evidence_json\")\n  triggeredAt                DateTime              @map(\"triggered_at\")\n  endedAt                    DateTime?             @map(\"ended_at\")\n  terminalReason             String?               @map(\"terminal_reason\")\n\n  group                    ProtectionGroup           @relation(fields: [groupId], references: [id], onDelete: Restrict)\n  leg                      ProtectionLeg             @relation(fields: [legId, groupId], references: [id, groupId], onDelete: Restrict)\n  order                    Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)\n  futuresExecution         FuturesExecution?         @relation(fields: [futuresExecutionId], references: [id], onDelete: Restrict)\n  assetPriceSnapshot       AssetPriceSnapshot?       @relation(fields: [assetPriceSnapshotId], references: [id], onDelete: Restrict)\n  futuresLastPriceSnapshot FuturesLastPriceSnapshot? @relation(fields: [futuresLastPriceSnapshotId], references: [id], onDelete: Restrict)\n\n  @@index([groupId, triggeredAt, id])\n  @@index([assetPriceSnapshotId])\n  @@index([futuresLastPriceSnapshotId])\n  @@map(\"protection_children\")\n}\n\nmodel ProtectionCommand {\n  id                  String         @id @default(uuid())\n  tradingAccountId    String         @map(\"trading_account_id\")\n  idempotencyKey      String         @map(\"idempotency_key\")\n  requestHash         String         @map(\"request_hash\")\n  responsePayloadJson Json           @map(\"response_payload_json\")\n  createdAt           DateTime       @default(now()) @map(\"created_at\")\n  tradingAccount      TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n\n  @@unique([tradingAccountId, idempotencyKey])\n  @@map(\"protection_commands\")\n}\n\nmodel Position {\n  id                 String       @id @default(uuid())\n  tradingAccountId   String       @map(\"trading_account_id\")\n  assetId            String       @map(\"asset_id\")\n  quantity           Decimal      @db.Decimal(24, 8)\n  // Quantity locked by submitted limit-sell orders. It remains part of the\n  // owned position/equity until fill, but is unavailable to another sell.\n  reservedQuantity   Decimal      @default(0) @map(\"reserved_quantity\") @db.Decimal(24, 8)\n  averageCost        Decimal      @map(\"average_cost\") @db.Decimal(24, 8)\n  currencyCode       CurrencyCode @map(\"currency_code\")\n  realizedPnl        Decimal      @default(0) @map(\"realized_pnl\") @db.Decimal(24, 8)\n  realizedPnlKrw     Decimal      @default(0) @map(\"realized_pnl_krw\") @db.Decimal(24, 8)\n  currentPriceLocal  Decimal?     @map(\"current_price_local\") @db.Decimal(24, 8)\n  currentPriceKrw    Decimal?     @map(\"current_price_krw\") @db.Decimal(24, 8)\n  marketValueLocal   Decimal?     @map(\"market_value_local\") @db.Decimal(24, 8)\n  marketValueKrw     Decimal?     @map(\"market_value_krw\") @db.Decimal(24, 8)\n  unrealizedPnlLocal Decimal?     @map(\"unrealized_pnl_local\") @db.Decimal(24, 8)\n  unrealizedPnlKrw   Decimal?     @map(\"unrealized_pnl_krw\") @db.Decimal(24, 8)\n  createdAt          DateTime     @default(now()) @map(\"created_at\")\n  updatedAt          DateTime     @updatedAt @map(\"updated_at\")\n\n  tradingAccount   TradingAccount    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)\n  protectionGroups ProtectionGroup[]\n\n  // One aggregate position per asset per canonical trading account.\n  @@unique([tradingAccountId, assetId])\n  @@index([tradingAccountId])\n  @@index([assetId])\n  @@map(\"positions\")\n}\n\nmodel Order {\n  id                         String       @id @default(uuid())\n  tradingAccountId           String       @map(\"trading_account_id\")\n  assetId                    String       @map(\"asset_id\")\n  quoteId                    String?      @unique @map(\"quote_id\")\n  side                       OrderSide\n  orderType                  OrderType    @map(\"order_type\")\n  status                     OrderStatus  @default(submitted)\n  quantity                   Decimal      @db.Decimal(24, 8)\n  // One-shot ERS market result. Null on historical/snapshot/limit orders.\n  // quantity preserves quantity intent; amount BUY stores resolved quantity.\n  executedQuantity           Decimal?     @map(\"executed_quantity\") @db.Decimal(24, 8)\n  canceledQuantity           Decimal?     @map(\"canceled_quantity\") @db.Decimal(24, 8)\n  requestedAmount            Decimal?     @map(\"requested_amount\") @db.Decimal(24, 8)\n  unspentAmount              Decimal?     @map(\"unspent_amount\") @db.Decimal(24, 8)\n  executionEvidence          Json?        @map(\"execution_evidence\")\n  limitPrice                 Decimal?     @map(\"limit_price\") @db.Decimal(24, 8)\n  executedPrice              Decimal?     @map(\"executed_price\") @db.Decimal(24, 8)\n  currencyCode               CurrencyCode @map(\"currency_code\")\n  // Immutable canonical cash identity: account + scope + settlement currency.\n  // All pre-cutover orders are backfilled to securities, including crypto.\n  cashWalletScope            WalletScope  @map(\"cash_wallet_scope\")\n  grossAmount                Decimal?     @map(\"gross_amount\") @db.Decimal(24, 8)\n  feeAmount                  Decimal?     @map(\"fee_amount\") @db.Decimal(24, 8)\n  netAmount                  Decimal?     @map(\"net_amount\") @db.Decimal(24, 8)\n  assetPriceSnapshotId       String?      @map(\"asset_price_snapshot_id\")\n  fxRateSnapshotId           String?      @map(\"fx_rate_snapshot_id\")\n  idempotencyKey             String?      @map(\"idempotency_key\")\n  requestHash                String?      @map(\"request_hash\")\n  responsePayloadJson        Json?        @map(\"response_payload_json\")\n  // Limit-order reservation bookkeeping: buys use reservedAmount, sells use\n  // reservedQuantity; both pin reservationFeeRate for future execution and\n  // record reservationReleasedAt on fill/cancel/cleanup.\n  reservedAmount             Decimal?     @map(\"reserved_amount\") @db.Decimal(24, 8)\n  // Limit-sell reservation bookkeeping. Cash reservations use\n  // reservedAmount; quantity reservations use this field.\n  reservedQuantity           Decimal?     @map(\"reserved_quantity\") @db.Decimal(24, 8)\n  reservationFeeRate         Decimal?     @map(\"reservation_fee_rate\") @db.Decimal(10, 6)\n  reservationReleasedAt      DateTime?    @map(\"reservation_released_at\")\n  cancelReason               String?      @map(\"cancel_reason\")\n  // Closed-candle evidence link written by scheduler path-B matching.\n  limitOrderCandleEvidenceId String?      @map(\"limit_order_candle_evidence_id\")\n  submittedAt                DateTime     @map(\"submitted_at\")\n  executedAt                 DateTime?    @map(\"executed_at\")\n  canceledAt                 DateTime?    @map(\"canceled_at\")\n  rejectedAt                 DateTime?    @map(\"rejected_at\")\n  rejectReason               String?      @map(\"reject_reason\")\n  createdAt                  DateTime     @default(now()) @map(\"created_at\")\n  updatedAt                  DateTime     @updatedAt @map(\"updated_at\")\n\n  tradingAccount     TradingAccount            @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  asset              Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)\n  quote              Quote?                    @relation(fields: [quoteId], references: [id], onDelete: Restrict)\n  assetPriceSnapshot AssetPriceSnapshot?       @relation(fields: [assetPriceSnapshotId], references: [id], onDelete: Restrict)\n  fxRateSnapshot     FxRateSnapshot?           @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict)\n  candleEvidence     LimitOrderCandleEvidence? @relation(fields: [limitOrderCandleEvidenceId], references: [id], onDelete: Restrict)\n  attachedProtection ProtectionGroup?\n  protectionChild    ProtectionChild?\n\n  // Account-scoped create idempotency: the same key may be reused by the\n  // SAME user on a different trading account. idempotencyKey stays nullable.\n  @@unique([tradingAccountId, idempotencyKey])\n  @@index([tradingAccountId, submittedAt])\n  @@index([tradingAccountId, status])\n  @@index([assetId])\n  @@index([quoteId])\n  @@index([assetPriceSnapshotId])\n  @@index([fxRateSnapshotId])\n  @@index([submittedAt])\n  @@index([status])\n  @@index([limitOrderCandleEvidenceId])\n  @@map(\"orders\")\n}\n\nmodel CashWallet {\n  id               String       @id @default(uuid())\n  tradingAccountId String       @map(\"trading_account_id\")\n  // Canonical provisioning explicitly supplies all four scope/currency pairs.\n  walletScope      WalletScope  @default(securities) @map(\"wallet_scope\")\n  currencyCode     CurrencyCode @map(\"currency_code\")\n  balanceAmount    Decimal      @map(\"balance_amount\") @db.Decimal(24, 8)\n  // Cash locked by submitted limit-buy orders. Never subtracted from total\n  // asset valuation; availableAmount (= balance - reserved) is derived at\n  // read time and is the ceiling for every ordinary cash debit.\n  reservedAmount   Decimal      @default(0) @map(\"reserved_amount\") @db.Decimal(24, 8)\n  createdAt        DateTime     @default(now()) @map(\"created_at\")\n  updatedAt        DateTime     @updatedAt @map(\"updated_at\")\n\n  tradingAccount         TradingAccount        @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  walletTransactions     WalletTransaction[]\n  outgoingTransfers      WalletTransfer[]      @relation(\"TransferSource\")\n  incomingTransfers      WalletTransfer[]      @relation(\"TransferDestination\")\n  outgoingTransferQuotes WalletTransferQuote[] @relation(\"TransferQuoteSource\")\n  incomingTransferQuotes WalletTransferQuote[] @relation(\"TransferQuoteDestination\")\n\n  // Scope/currency CHECK is SQL-only: securities KRW/USD, crypto scopes USD.\n  @@unique([tradingAccountId, walletScope, currencyCode])\n  @@index([tradingAccountId])\n  @@map(\"cash_wallets\")\n}\n\nmodel WalletTransaction {\n  id               String                         @id @default(uuid())\n  tradingAccountId String                         @map(\"trading_account_id\")\n  walletId         String                         @map(\"wallet_id\")\n  currencyCode     CurrencyCode                   @map(\"currency_code\")\n  direction        WalletTransactionDirection\n  txType           WalletTransactionType          @map(\"tx_type\")\n  referenceType    WalletTransactionReferenceType @map(\"reference_type\")\n  referenceId      String?                        @map(\"reference_id\")\n  amount           Decimal                        @db.Decimal(24, 8)\n  balanceAfter     Decimal                        @map(\"balance_after\") @db.Decimal(24, 8)\n  occurredAt       DateTime                       @map(\"occurred_at\")\n  createdAt        DateTime                       @default(now()) @map(\"created_at\")\n\n  tradingAccount TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  wallet         CashWallet     @relation(fields: [walletId], references: [id], onDelete: Restrict)\n  adRewardClaim  AdRewardClaim?\n\n  // NO global @@unique([referenceType, referenceId]): one order or one\n  // exchange legitimately produces several ledger rows. Single-row\n  // references are protected by PARTIAL unique indexes instead, which\n  // Prisma's DSL cannot express — see the\n  // add_general_account_and_ad_reward_foundation migration:\n  //   wallet_transactions_general_account_open_reference_unique\n  //     UNIQUE (reference_id) WHERE reference_type = 'general_account_open'\n  //   wallet_transactions_ad_reward_claim_reference_unique\n  //     UNIQUE (reference_id) WHERE reference_type = 'ad_reward_claim'\n  @@index([tradingAccountId, occurredAt])\n  // External-funding aggregation for general accounts filters by txType\n  // (initial_grant / ad_reward) within an account.\n  @@index([tradingAccountId, txType, occurredAt])\n  @@index([walletId, occurredAt])\n  @@index([referenceType, referenceId])\n  @@map(\"wallet_transactions\")\n}\n\n/// Rewarded-ad funding events for GENERAL-mode accounts only.\n///\n/// A claim row is created ONLY after a registered server-side verifier\n/// accepted the ad proof: providerEventId is the verifier's identifier, never\n/// a client-supplied string, and rewardAmountKrw always comes from server\n/// configuration. verificationFingerprint stores a one-way SHA-256 digest of\n/// the proof — never the proof, provider token, signing secret, or raw\n/// callback body. verificationMetadataJson holds only the non-sensitive\n/// fields the adapter explicitly allowed.\n///\n/// Cumulative ad funding is DERIVED (sum of granted claims / ad_reward ledger\n/// rows); no aggregate column lives on TradingAccount, and a reward never\n/// changes TradingAccount.initialCapitalKrw.\nmodel AdRewardClaim {\n  id                       String              @id @default(uuid())\n  userId                   String              @map(\"user_id\")\n  tradingAccountId         String              @map(\"trading_account_id\")\n  provider                 String\n  providerEventId          String              @map(\"provider_event_id\")\n  status                   AdRewardClaimStatus\n  rewardAmountKrw          Decimal             @map(\"reward_amount_krw\") @db.Decimal(24, 8)\n  verificationFingerprint  String?             @map(\"verification_fingerprint\")\n  verificationMetadataJson Json?               @map(\"verification_metadata_json\")\n  requestedAt              DateTime            @map(\"requested_at\")\n  verifiedAt               DateTime?           @map(\"verified_at\")\n  grantedAt                DateTime?           @map(\"granted_at\")\n  rejectedAt               DateTime?           @map(\"rejected_at\")\n  failedAt                 DateTime?           @map(\"failed_at\")\n  failureCode              String?             @map(\"failure_code\")\n  failureReason            String?             @map(\"failure_reason\")\n  /// Set only for granted claims; 1:1 with the ad_reward ledger row.\n  walletTransactionId      String?             @unique @map(\"wallet_transaction_id\")\n  /// COMMAND idempotency (작업 6 보완). Distinct from (provider,\n  /// providerEventId): that one stops the same AD EVENT from paying twice,\n  /// this one lets a client safely RETRY the same request without another\n  /// verifier round trip. Nullable so pre-작업 7 rows stay valid; PostgreSQL\n  /// treats NULLs as distinct, so only keyed claims are constrained.\n  idempotencyKey           String?             @map(\"idempotency_key\")\n  /// sha256 over (api version, provider, proof fingerprint). Same key +\n  /// different hash is AD_REWARD_IDEMPOTENCY_CONFLICT. The raw proof is never\n  /// an input to anything stored.\n  requestHash              String?             @map(\"request_hash\")\n  /// The first committed success/refusal payload, replayed verbatim on retry.\n  responsePayloadJson      Json?               @map(\"response_payload_json\")\n  createdAt                DateTime            @default(now()) @map(\"created_at\")\n  updatedAt                DateTime            @updatedAt @map(\"updated_at\")\n\n  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)\n  tradingAccount    TradingAccount     @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)\n\n  /// The duplicate-payout guard: one provider event can be granted once.\n  @@unique([provider, providerEventId])\n  /// The command-retry guard. Deliberately SEPARATE from the guard above —\n  /// they protect different things and must never be merged.\n  @@unique([tradingAccountId, idempotencyKey])\n  @@index([tradingAccountId, grantedAt])\n  @@index([tradingAccountId, createdAt])\n  @@index([userId, grantedAt])\n  @@index([status, createdAt])\n  @@map(\"ad_reward_claims\")\n}\n\nmodel ExchangeTransaction {\n  id                String       @id @default(uuid())\n  tradingAccountId  String       @map(\"trading_account_id\")\n  fxRateSnapshotId  String?      @map(\"fx_rate_snapshot_id\")\n  fromCurrency      CurrencyCode @map(\"from_currency\")\n  toCurrency        CurrencyCode @map(\"to_currency\")\n  sourceAmount      Decimal      @map(\"source_amount\") @db.Decimal(24, 8)\n  grossTargetAmount Decimal      @map(\"gross_target_amount\") @db.Decimal(24, 8)\n  feeRate           Decimal      @map(\"fee_rate\") @db.Decimal(10, 6)\n  feeAmount         Decimal      @map(\"fee_amount\") @db.Decimal(24, 8)\n  feeCurrency       CurrencyCode @map(\"fee_currency\")\n  appliedRate       Decimal      @map(\"applied_rate\") @db.Decimal(18, 8)\n  netTargetAmount   Decimal      @map(\"net_target_amount\") @db.Decimal(24, 8)\n  executedAt        DateTime     @map(\"executed_at\")\n  createdAt         DateTime     @default(now()) @map(\"created_at\")\n\n  tradingAccount               TradingAccount                @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  fxRateSnapshot               FxRateSnapshot?               @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict)\n  fxExecuteRequests            FxExecuteRequest[]\n  walletTransferExecuteRequest WalletTransferExecuteRequest?\n\n  @@index([tradingAccountId, executedAt])\n  @@index([fxRateSnapshotId])\n  @@index([fromCurrency, toCurrency, executedAt])\n  @@map(\"exchange_transactions\")\n}\n\nmodel FxRateSnapshot {\n  id               String           @id @default(uuid())\n  baseCurrency     CurrencyCode     @map(\"base_currency\")\n  quoteCurrency    CurrencyCode     @map(\"quote_currency\")\n  rate             Decimal          @db.Decimal(18, 8)\n  sourceType       FxRateSourceType @map(\"source_type\")\n  sourceName       String?          @map(\"source_name\")\n  sourceTimestamp  DateTime?        @map(\"source_timestamp\")\n  effectiveAt      DateTime         @map(\"effective_at\")\n  capturedAt       DateTime         @map(\"captured_at\")\n  createdAt        DateTime         @default(now()) @map(\"created_at\")\n  rawPayloadJson   Json?            @map(\"raw_payload_json\")\n  approvedByUserId String?          @map(\"approved_by_user_id\")\n  note             String?\n\n  exchangeTransactions ExchangeTransaction[]\n  orders               Order[]\n  quotes               Quote[]\n\n  @@index([baseCurrency, quoteCurrency, effectiveAt])\n  @@index([baseCurrency, quoteCurrency, capturedAt])\n  @@index([sourceType, effectiveAt])\n  @@map(\"fx_rate_snapshots\")\n}\n\nmodel Quote {\n  id                   String        @id @default(uuid())\n  userId               String        @map(\"user_id\")\n  tradingAccountId     String        @map(\"trading_account_id\")\n  quoteType            QuoteType     @map(\"quote_type\")\n  status               QuoteStatus   @default(active)\n  assetId              String?       @map(\"asset_id\")\n  side                 OrderSide?\n  orderType            OrderType?    @map(\"order_type\")\n  quantity             Decimal?      @db.Decimal(24, 8)\n  limitPrice           Decimal?      @map(\"limit_price\") @db.Decimal(24, 8)\n  fromCurrency         CurrencyCode? @map(\"from_currency\")\n  toCurrency           CurrencyCode? @map(\"to_currency\")\n  // FX: input source currency amount. Order crypto BUY: gross principal intent\n  // in currencyCode (excludes fees); other order quotes leave this null.\n  sourceAmount         Decimal?      @map(\"source_amount\") @db.Decimal(24, 8)\n  targetAmount         Decimal?      @map(\"target_amount\") @db.Decimal(24, 8)\n  currencyCode         CurrencyCode? @map(\"currency_code\")\n  // Required by a SQL CHECK for order quotes; FX leaves this null.\n  cashWalletScope      WalletScope?  @map(\"cash_wallet_scope\")\n  quotedPrice          Decimal?      @map(\"quoted_price\") @db.Decimal(24, 8)\n  quotedRate           Decimal?      @map(\"quoted_rate\") @db.Decimal(18, 8)\n  // Fee rate pinned AT QUOTE TIME for new market, limit and FX quotes in both\n  // account modes. Nullable only for legacy compatibility. Market/FX amounts\n  // still use the execute price/rate. Limit-buy reserves quotedReservedAmount;\n  // limit-sell reserves quantity and uses quotedNetAmount.\n  quotedFeeRate        Decimal?      @map(\"quoted_fee_rate\") @db.Decimal(10, 6)\n  quotedGrossAmount    Decimal?      @map(\"quoted_gross_amount\") @db.Decimal(24, 8)\n  quotedFeeAmount      Decimal?      @map(\"quoted_fee_amount\") @db.Decimal(24, 8)\n  quotedReservedAmount Decimal?      @map(\"quoted_reserved_amount\") @db.Decimal(24, 8)\n  // Limit-sell estimated proceeds (gross - fee), pinned at quote time.\n  quotedNetAmount      Decimal?      @map(\"quoted_net_amount\") @db.Decimal(24, 8)\n  assetPriceSnapshotId String?       @map(\"asset_price_snapshot_id\")\n  fxRateSnapshotId     String?       @map(\"fx_rate_snapshot_id\")\n  assetPriceSourceJson Json?         @map(\"asset_price_source_json\")\n  fxRateSourceJson     Json?         @map(\"fx_rate_source_json\")\n  maxChangeBps         Decimal       @map(\"max_change_bps\") @db.Decimal(10, 4)\n  expiresAt            DateTime      @map(\"expires_at\")\n  requestHash          String        @map(\"request_hash\")\n  consumedAt           DateTime?     @map(\"consumed_at\")\n  createdAt            DateTime      @default(now()) @map(\"created_at\")\n  updatedAt            DateTime      @updatedAt @map(\"updated_at\")\n\n  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)\n  tradingAccount     TradingAccount      @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: Restrict)\n  assetPriceSnapshot AssetPriceSnapshot? @relation(fields: [assetPriceSnapshotId], references: [id], onDelete: Restrict)\n  fxRateSnapshot     FxRateSnapshot?     @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict)\n  orders             Order[]\n\n  walletTransferQuote WalletTransferQuote?\n\n  @@index([userId, createdAt])\n  @@index([tradingAccountId, createdAt])\n  @@index([tradingAccountId, status, expiresAt])\n  @@index([quoteType, status, expiresAt])\n  @@index([requestHash])\n  @@index([assetId, createdAt])\n  @@index([fxRateSnapshotId])\n  @@index([assetPriceSnapshotId])\n  @@map(\"quotes\")\n}\n\n// Only committed internal USD commands exist; failure rolls the entire row back.\nmodel WalletTransfer {\n  id                  String       @id @default(uuid())\n  tradingAccountId    String       @map(\"trading_account_id\")\n  sourceWalletId      String       @map(\"source_wallet_id\")\n  destinationWalletId String       @map(\"destination_wallet_id\")\n  currencyCode        CurrencyCode @map(\"currency_code\")\n  amount              Decimal      @db.Decimal(24, 8)\n  idempotencyKey      String       @map(\"idempotency_key\")\n  requestHash         String       @map(\"request_hash\")\n  responsePayloadJson Json         @map(\"response_payload_json\")\n  executedAt          DateTime     @map(\"executed_at\")\n\n  tradingAccount    TradingAccount                @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  sourceWallet      CashWallet                    @relation(\"TransferSource\", fields: [sourceWalletId], references: [id], onDelete: Restrict)\n  destinationWallet CashWallet                    @relation(\"TransferDestination\", fields: [destinationWalletId], references: [id], onDelete: Restrict)\n  compositeCommand  WalletTransferExecuteRequest?\n\n  @@unique([tradingAccountId, idempotencyKey])\n  @@index([tradingAccountId, executedAt])\n  @@map(\"wallet_transfers\")\n}\n\n// Typed route extension; all FX financial evidence stays on the canonical Quote.\nmodel WalletTransferQuote {\n  quoteId             String @id @map(\"quote_id\")\n  sourceWalletId      String @map(\"source_wallet_id\")\n  destinationWalletId String @map(\"destination_wallet_id\")\n\n  quote             Quote                         @relation(fields: [quoteId], references: [id], onDelete: Restrict)\n  sourceWallet      CashWallet                    @relation(\"TransferQuoteSource\", fields: [sourceWalletId], references: [id], onDelete: Restrict)\n  destinationWallet CashWallet                    @relation(\"TransferQuoteDestination\", fields: [destinationWalletId], references: [id], onDelete: Restrict)\n  command           WalletTransferExecuteRequest?\n\n  @@index([sourceWalletId])\n  @@index([destinationWalletId])\n  @@map(\"wallet_transfer_quotes\")\n}\n\n// Exists only if BOTH financial events and their ledger/snapshot writes commit.\nmodel WalletTransferExecuteRequest {\n  id                    String   @id @default(uuid())\n  tradingAccountId      String   @map(\"trading_account_id\")\n  quoteId               String   @unique @map(\"quote_id\")\n  idempotencyKey        String   @map(\"idempotency_key\")\n  requestHash           String   @map(\"request_hash\")\n  exchangeTransactionId String   @unique @map(\"exchange_transaction_id\")\n  walletTransferId      String   @unique @map(\"wallet_transfer_id\")\n  responsePayloadJson   Json     @map(\"response_payload_json\")\n  executedAt            DateTime @map(\"executed_at\")\n\n  tradingAccount      TradingAccount      @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  quote               WalletTransferQuote @relation(fields: [quoteId], references: [quoteId], onDelete: Restrict)\n  exchangeTransaction ExchangeTransaction @relation(fields: [exchangeTransactionId], references: [id], onDelete: Restrict)\n  walletTransfer      WalletTransfer      @relation(fields: [walletTransferId], references: [id], onDelete: Restrict)\n\n  @@unique([tradingAccountId, idempotencyKey])\n  @@index([tradingAccountId, executedAt])\n  @@map(\"wallet_transfer_execute_requests\")\n}\n\nmodel FxExecuteRequest {\n  id                    String                 @id @default(uuid())\n  userId                String                 @map(\"user_id\")\n  tradingAccountId      String                 @map(\"trading_account_id\")\n  idempotencyKey        String                 @map(\"idempotency_key\")\n  requestHash           String                 @map(\"request_hash\")\n  fromCurrency          CurrencyCode           @map(\"from_currency\")\n  toCurrency            CurrencyCode           @map(\"to_currency\")\n  sourceAmount          Decimal                @map(\"source_amount\") @db.Decimal(24, 8)\n  status                FxExecuteRequestStatus\n  exchangeTransactionId String?                @map(\"exchange_transaction_id\")\n  responsePayloadJson   Json?                  @map(\"response_payload_json\")\n  errorCode             String?                @map(\"error_code\")\n  errorMessage          String?                @map(\"error_message\")\n  requestedAt           DateTime               @map(\"requested_at\")\n  completedAt           DateTime?              @map(\"completed_at\")\n  createdAt             DateTime               @default(now()) @map(\"created_at\")\n  updatedAt             DateTime               @updatedAt @map(\"updated_at\")\n\n  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)\n  tradingAccount      TradingAccount       @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n  exchangeTransaction ExchangeTransaction? @relation(fields: [exchangeTransactionId], references: [id], onDelete: Restrict)\n\n  // Account-scoped idempotency: the SAME user may reuse a key across two\n  // different trading accounts (e.g. a season and a general account);\n  // within one account the key stays unique.\n  //\n  @@unique([tradingAccountId, idempotencyKey])\n  @@index([tradingAccountId, requestedAt])\n  @@index([status, requestedAt])\n  @@index([exchangeTransactionId])\n  @@map(\"fx_execute_requests\")\n}\n\n/// Point-in-time equity/performance record.\n///\n/// SEASON rows keep their historical meaning: returnRate is the simple\n/// initial-capital return and the general-performance columns stay NULL.\n/// GENERAL rows carry the time-weighted performance state instead — returnRate is the TWR percent,\n/// i.e. (timeWeightedReturnFactor - 1) * 100. The two meanings are never\n/// mixed; API responses always name which one applies via returnRateMethod.\n///\n/// timeWeightedReturnFactor is the SOURCE OF TRUTH for general performance;\n/// returnRate is a rounded presentation of it and is never fed back into the\n/// next factor calculation.\nmodel EquitySnapshot {\n  id                           String                          @id @default(uuid())\n  tradingAccountId             String                          @map(\"trading_account_id\")\n  totalAssetKrw                Decimal                         @map(\"total_asset_krw\") @db.Decimal(24, 8)\n  returnRate                   Decimal                         @map(\"return_rate\") @db.Decimal(12, 8)\n  krwCash                      Decimal                         @map(\"krw_cash\") @db.Decimal(24, 8)\n  usdCashKrw                   Decimal                         @map(\"usd_cash_krw\") @db.Decimal(24, 8)\n  domesticStockValueKrw        Decimal                         @map(\"domestic_stock_value_krw\") @db.Decimal(24, 8)\n  usStockValueKrw              Decimal                         @map(\"us_stock_value_krw\") @db.Decimal(24, 8)\n  cryptoValueKrw               Decimal                         @map(\"crypto_value_krw\") @db.Decimal(24, 8)\n  /// Signed Mark UPNL; NULL preserves pre-F3 snapshot semantics.\n  futuresUnrealizedPnlUsd      Decimal?                        @map(\"futures_unrealized_pnl_usd\") @db.Decimal(24, 8)\n  futuresUnrealizedPnlKrw      Decimal?                        @map(\"futures_unrealized_pnl_krw\") @db.Decimal(24, 8)\n  futuresValuationJson         Json?                           @map(\"futures_valuation_json\")\n  snapshotReason               SnapshotReason                  @map(\"snapshot_reason\")\n  // ---- general-mode performance state (NULL on season rows) ----\n  /// initial_grant + ad_reward inflows to date. Never a guess: only the two\n  /// explicitly external ledger reference types count.\n  cumulativeExternalFundingKrw Decimal?                        @map(\"cumulative_external_funding_krw\") @db.Decimal(24, 8)\n  /// totalAssetKrw - cumulativeExternalFundingKrw.\n  investmentPnlKrw             Decimal?                        @map(\"investment_pnl_krw\") @db.Decimal(24, 8)\n  /// Cumulative time-weighted return factor (1 = flat). High precision so\n  /// chained segments do not drift.\n  timeWeightedReturnFactor     Decimal?                        @map(\"time_weighted_return_factor\") @db.Decimal(38, 18)\n  // ---- external-funding boundary (set ONLY on the before/after pair and on\n  // the general_account_open origin) ----\n  externalFundingAmountKrw     Decimal?                        @map(\"external_funding_amount_krw\") @db.Decimal(24, 8)\n  externalFundingReferenceType WalletTransactionReferenceType? @map(\"external_funding_reference_type\")\n  externalFundingReferenceId   String?                         @map(\"external_funding_reference_id\")\n  capturedAt                   DateTime                        @map(\"captured_at\")\n  createdAt                    DateTime                        @default(now()) @map(\"created_at\")\n\n  tradingAccount TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n\n  // A boundary snapshot exists at most once per (account, reference, phase).\n  // The three boundary columns remain nullable, so PostgreSQL leaves ordinary\n  // season/ordinary snapshots unaffected.\n  @@unique([tradingAccountId, externalFundingReferenceType, externalFundingReferenceId, snapshotReason], name: \"equity_snapshot_external_funding_boundary\", map: \"equity_snapshots_external_funding_boundary_key\")\n  @@index([tradingAccountId, capturedAt])\n  @@index([tradingAccountId, snapshotReason, capturedAt], map: \"equity_snapshots_trading_account_id_snapshot_reason_captured_at\")\n  @@index([externalFundingReferenceType, externalFundingReferenceId], map: \"equity_snapshots_external_funding_reference_idx\")\n  @@index([snapshotReason, capturedAt])\n  @@map(\"equity_snapshots\")\n}\n\n/// One row per subject per calendar day. Same season/general split as\n/// EquitySnapshot: returnRate is the initial-capital return for season rows\n/// and the TWR percent for general rows.\nmodel DailyPortfolioSnapshot {\n  id                           String   @id @default(uuid())\n  tradingAccountId             String   @map(\"trading_account_id\")\n  snapshotDate                 DateTime @map(\"snapshot_date\") @db.Date\n  totalAssetKrw                Decimal  @map(\"total_asset_krw\") @db.Decimal(24, 8)\n  returnRate                   Decimal  @map(\"return_rate\") @db.Decimal(12, 8)\n  krwCash                      Decimal  @map(\"krw_cash\") @db.Decimal(24, 8)\n  usdCashKrw                   Decimal  @map(\"usd_cash_krw\") @db.Decimal(24, 8)\n  assetValueKrw                Decimal  @map(\"asset_value_krw\") @db.Decimal(24, 8)\n  realizedPnlKrw               Decimal  @map(\"realized_pnl_krw\") @db.Decimal(24, 8)\n  unrealizedPnlKrw             Decimal  @map(\"unrealized_pnl_krw\") @db.Decimal(24, 8)\n  futuresUnrealizedPnlUsd      Decimal? @map(\"futures_unrealized_pnl_usd\") @db.Decimal(24, 8)\n  futuresUnrealizedPnlKrw      Decimal? @map(\"futures_unrealized_pnl_krw\") @db.Decimal(24, 8)\n  futuresValuationJson         Json?    @map(\"futures_valuation_json\")\n  // ---- general-mode performance state (NULL on season rows) ----\n  cumulativeExternalFundingKrw Decimal? @map(\"cumulative_external_funding_krw\") @db.Decimal(24, 8)\n  investmentPnlKrw             Decimal? @map(\"investment_pnl_krw\") @db.Decimal(24, 8)\n  timeWeightedReturnFactor     Decimal? @map(\"time_weighted_return_factor\") @db.Decimal(38, 18)\n  capturedAt                   DateTime @map(\"captured_at\")\n  createdAt                    DateTime @default(now()) @map(\"created_at\")\n\n  tradingAccount TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n\n  /// One daily row per canonical account per date.\n  @@unique([tradingAccountId, snapshotDate])\n  @@index([snapshotDate])\n  @@index([tradingAccountId, capturedAt])\n  @@index([tradingAccountId, snapshotDate])\n  @@map(\"daily_portfolio_snapshots\")\n}\n\nmodel SeasonRanking {\n  id                  String            @id @default(uuid())\n  seasonId            String            @map(\"season_id\")\n  seasonParticipantId String            @map(\"season_participant_id\")\n  // Canonical account scope for the scored portfolio. SeasonRanking remains a\n  // season-domain model, so its participant relation is also retained.\n  tradingAccountId    String            @map(\"trading_account_id\")\n  rankType            SeasonRankingType @default(daily) @map(\"rank_type\")\n  rank                Int\n  totalAssetKrw       Decimal           @map(\"total_asset_krw\") @db.Decimal(24, 8)\n  returnRate          Decimal           @map(\"return_rate\") @db.Decimal(12, 8)\n  maxDrawdown         Decimal           @default(0) @map(\"max_drawdown\") @db.Decimal(12, 8)\n  totalFillCount      Int               @default(0) @map(\"total_fill_count\")\n  reachedReturnAt     DateTime?         @map(\"reached_return_at\")\n  rankingDate         DateTime          @map(\"ranking_date\") @db.Date\n  capturedAt          DateTime          @map(\"captured_at\")\n  createdAt           DateTime          @default(now()) @map(\"created_at\")\n\n  season            Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)\n  seasonParticipant SeasonParticipant @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)\n  tradingAccount    TradingAccount    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)\n\n  @@unique([seasonId, rankType, rankingDate, seasonParticipantId])\n  @@unique([seasonId, rankType, rankingDate, rank])\n  // One ranking row per ACCOUNT per (season, rankType, date), the canonical\n  // ownership twin of the retained participant unique.\n  @@unique([seasonId, rankType, rankingDate, tradingAccountId])\n  @@index([seasonId, rankType, rankingDate, rank])\n  @@index([seasonParticipantId, rankingDate])\n  @@index([tradingAccountId, rankingDate])\n  @@map(\"season_rankings\")\n}\n\nmodel BatchJobRun {\n  id                 String         @id @default(uuid())\n  jobName            String         @map(\"job_name\")\n  idempotencyKey     String         @map(\"idempotency_key\")\n  status             BatchJobStatus @default(pending)\n  dryRun             Boolean        @default(false) @map(\"dry_run\")\n  startedAt          DateTime?      @map(\"started_at\")\n  finishedAt         DateTime?      @map(\"finished_at\")\n  requestedBy        String?        @map(\"requested_by\")\n  requestPayloadJson Json?          @map(\"request_payload_json\")\n  resultPayloadJson  Json?          @map(\"result_payload_json\")\n  errorCode          String?        @map(\"error_code\")\n  errorMessage       String?        @map(\"error_message\")\n  createdAt          DateTime       @default(now()) @map(\"created_at\")\n  updatedAt          DateTime       @updatedAt @map(\"updated_at\")\n\n  @@unique([jobName, idempotencyKey])\n  @@index([jobName, status])\n  @@index([jobName, createdAt])\n  @@index([status, createdAt])\n  @@map(\"batch_job_runs\")\n}\n\nmodel OpsJobRun {\n  id             String          @id @default(uuid())\n  jobName        OpsJobName      @map(\"job_name\")\n  status         OpsJobRunStatus\n  trigger        OpsJobTrigger\n  requestedBy    String?         @map(\"requested_by\")\n  startedAt      DateTime        @map(\"started_at\")\n  finishedAt     DateTime?       @map(\"finished_at\")\n  durationMs     Int?            @map(\"duration_ms\")\n  lockKey        String?         @map(\"lock_key\")\n  idempotencyKey String?         @map(\"idempotency_key\")\n  dryRun         Boolean         @default(false) @map(\"dry_run\")\n  attempt        Int             @default(1)\n  maxAttempts    Int             @default(1) @map(\"max_attempts\")\n  errorCode      String?         @map(\"error_code\")\n  errorMessage   String?         @map(\"error_message\")\n  resultJson     Json?           @map(\"result_json\")\n  metadataJson   Json?           @map(\"metadata_json\")\n  createdAt      DateTime        @default(now()) @map(\"created_at\")\n  updatedAt      DateTime        @updatedAt @map(\"updated_at\")\n\n  @@unique([jobName, idempotencyKey])\n  @@index([jobName, startedAt])\n  @@index([status, startedAt])\n  @@index([trigger, startedAt])\n  @@index([lockKey])\n  @@map(\"ops_job_runs\")\n}\n\nmodel OpsJobLock {\n  id         String     @id @default(uuid())\n  lockKey    String     @unique @map(\"lock_key\")\n  jobName    OpsJobName @map(\"job_name\")\n  ownerId    String     @map(\"owner_id\")\n  acquiredAt DateTime   @map(\"acquired_at\")\n  expiresAt  DateTime   @map(\"expires_at\")\n  releasedAt DateTime?  @map(\"released_at\")\n  createdAt  DateTime   @default(now()) @map(\"created_at\")\n  updatedAt  DateTime   @updatedAt @map(\"updated_at\")\n\n  @@index([jobName, expiresAt])\n  @@index([expiresAt])\n  @@map(\"ops_job_locks\")\n}\n\n// Closed-candle trigger evidence (spec §7 model). One row per candle is shared\n// by every order the candle fills — the candle IS the evidence, and the\n// duplicated columns keep the fill reason reproducible even after retention\n// removes the candle row. Deliberately NOT foreign-keyed to market_candles:\n// evidence must outlive the candle (§18), so market_candle_id is a plain\n// denormalized reference. Identity is (asset, interval, window, provider), so\n// one row is shared by every order the same closed 5m candle fills. The actual\n// per-order fill price is the ORDER's limitPrice (Order.executedPrice); this\n// row only records that the limit was touched and the fill-price policy.\nmodel LimitOrderCandleEvidence {\n  id                   String   @id @default(uuid())\n  // Denormalized reference to the candle that proved the touch (no FK — the\n  // candle may be retention-deleted while this evidence lives on).\n  marketCandleId       String   @map(\"market_candle_id\")\n  assetId              String   @map(\"asset_id\")\n  interval             String\n  openTime             DateTime @map(\"open_time\") @db.Timestamptz(3)\n  closeTime            DateTime @map(\"close_time\") @db.Timestamptz(3)\n  triggerLowPrice      Decimal  @map(\"trigger_low_price\") @db.Decimal(24, 8)\n  triggerHighPrice     Decimal? @map(\"trigger_high_price\") @db.Decimal(24, 8)\n  // Always 'limit_price': a 5m low proves the limit was touched, never the\n  // price a fill could actually have been obtained at.\n  executionPricePolicy String   @map(\"execution_price_policy\")\n  provider             String\n  sourceName           String   @map(\"source_name\")\n  sourceUpdatedAt      DateTime @map(\"source_updated_at\") @db.Timestamptz(3)\n  finalizedAt          DateTime @map(\"finalized_at\") @db.Timestamptz(3)\n  policyVersion        Int      @map(\"policy_version\")\n  createdAt            DateTime @default(now()) @map(\"created_at\") @db.Timestamptz(3)\n\n  asset  Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)\n  orders Order[]\n\n  @@unique([assetId, interval, openTime, provider], map: \"limit_order_candle_evidences_asset_interval_open_provider_key\")\n  @@index([assetId, openTime])\n  @@map(\"limit_order_candle_evidences\")\n}\n\nenum FuturesMarkSource {\n  binance_usdm_mark_ws\n  binance_usdm_mark_rest\n}\n\nenum FuturesLastPriceSource {\n  binance_usdm_agg_trade_ws\n  binance_usdm_ticker_price_rest\n}\n\n// Binance USDⓈ-M perpetual last trade observations: the Futures execution,\n// trigger and Season final price. Never Spot, Mark or Index evidence.\n// effectiveAt is the provider trade time; capturedAt is the server receipt time.\nmodel FuturesLastPriceSnapshot {\n  id                 String                 @id @default(uuid())\n  instrumentId       String                 @map(\"instrument_id\")\n  symbol             String\n  providerProduct    String                 @default(\"binance_usdm_perpetual\") @map(\"provider_product\")\n  currencyCode       CurrencyCode           @default(USD) @map(\"currency_code\")\n  source             FuturesLastPriceSource\n  price              Decimal                @db.Decimal(24, 8)\n  effectiveAt        DateTime               @map(\"effective_at\")\n  capturedAt         DateTime               @map(\"captured_at\")\n  instrument         FuturesInstrument      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)\n  executions         FuturesExecution[]\n  seasonPrices       FuturesSeasonPrice[]\n  protectionTriggers ProtectionChild[]\n\n  @@unique([instrumentId, source, capturedAt])\n  @@index([instrumentId, effectiveAt, capturedAt])\n  @@index([capturedAt, id])\n  @@map(\"futures_last_price_snapshots\")\n}\n\n// Deliberately separate from Spot valuation/execution evidence.\nmodel FuturesMarkSnapshot {\n  id              String                    @id @default(uuid())\n  instrumentId    String                    @map(\"instrument_id\")\n  symbol          String\n  providerProduct String                    @default(\"binance_usdm_perpetual\") @map(\"provider_product\")\n  currencyCode    CurrencyCode              @default(USD) @map(\"currency_code\")\n  source          FuturesMarkSource\n  price           Decimal                   @db.Decimal(24, 8)\n  effectiveAt     DateTime                  @map(\"effective_at\")\n  capturedAt      DateTime                  @map(\"captured_at\")\n  instrument      FuturesInstrument         @relation(fields: [instrumentId], references: [id], onDelete: Restrict)\n  closes          FuturesLiquidationClose[]\n\n  @@unique([instrumentId, source, effectiveAt])\n  @@index([instrumentId, effectiveAt])\n  @@index([capturedAt, id])\n  @@map(\"futures_mark_snapshots\")\n}\n\nmodel FuturesLiquidation {\n  id                     String                    @id @default(uuid())\n  tradingAccountId       String                    @map(\"trading_account_id\")\n  marginMode             FuturesMarginMode         @map(\"margin_mode\")\n  evaluationAt           DateTime                  @map(\"evaluation_at\")\n  collateralAvailable    Decimal                   @map(\"collateral_available\") @db.Decimal(24, 8)\n  preEquity              Decimal  