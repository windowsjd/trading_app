"end_at\")\n  feeRate              Decimal                   @map(\"fee_rate\") @db.Decimal(10, 6)\n  createdAt            DateTime                  @default(now()) @map(\"created_at\")\n  season               Season                    @relation(fields: [seasonId], references: [id], onDelete: Restrict)\n  instrument           FuturesInstrument         @relation(fields: [instrumentId], references: [id], onDelete: Restrict)\n  snapshot             AssetPriceSnapshot?       @relation(fields: [assetPriceSnapshotId], references: [id], onDelete: Restrict)\n  lastPriceSnapshot    FuturesLastPriceSnapshot? @relation(fields: [lastPriceSnapshotId], references: [id], onDelete: Restrict)\n  closes               FuturesSeasonClose[]\n\n  @@unique([seasonId, instrumentId])\n  @@index([lastPriceSnapshotId])\n  @@map(\"futures_season_prices\")\n}\n\n// Normal Season final exit, deliberately separate from a risk liquidation.\nmodel FuturesSeasonSettlement {\n  id                  String               @id @default(uuid())\n  seasonId            String               @map(\"season_id\")\n  tradingAccountId    String               @unique @map(\"trading_account_id\")\n  endAt               DateTime             @map(\"end_at\")\n  feeRate             Decimal              @map(\"fee_rate\") @db.Decimal(10, 6)\n  realizedPnl         Decimal              @map(\"realized_pnl\") @db.Decimal(24, 8)\n  feeAmount           Decimal              @map(\"fee_amount\") @db.Decimal(24, 8)\n  settledPnl          Decimal              @map(\"settled_pnl\") @db.Decimal(24, 8)\n  settledFee          Decimal              @map(\"settled_fee\") @db.Decimal(24, 8)\n  settledCash         Decimal              @map(\"settled_cash\") @db.Decimal(24, 8)\n  bankruptcyShortfall Decimal              @map(\"bankruptcy_shortfall\") @db.Decimal(24, 8)\n  walletBalanceBefore Decimal              @map(\"wallet_balance_before\") @db.Decimal(24, 8)\n  walletBalanceAfter  Decimal              @map(\"wallet_balance_after\") @d