+import { BeginnerQuestEvidence } from './beginner-quest-evidence';
+import {
+  assertBeginnerLearningAccess,
+  beginnerOrderAction,
+  type BeginnerLearningAction,
+} from './beginner-learning-policy';
+import type { QuestClient } from './beginner-quest-evidence';
+
+const client = {} as QuestClient;
+const beginner = { id: 'beginner-a', mode: 'beginner' };
+afterEach(() => jest.restoreAllMocks());
+it.each(['general', 'season'])(
+  '%s never reads beginner evidence',
+  async (mode) => {
+    const spy = jest.spyOn(BeginnerQuestEvidence.prototype, 'read');
+    for (const action of [
+      'transfer',
+      'cryptoMarketBuy',
+      'spotProtection',
+      'cryptoLimitBuy',
+      'allTrading',
+    ] as const)
+      await assertBeginnerLearningAccess(client, { id: 'other', mode }, action);
+    expect(spy).not.toHaveBeenCalled();
+  },
+);
+it('risk reduction and exchange never require progress, including unavailable database', async () => {
+  await assertBeginnerLearningAccess(client, beginner, 'riskReduction');
+  await assertBeginnerLearningAccess(client, beginner, 'exchange');
+});
+it.each([0, 1, 2, 3, 4, 5, 6])(
+  'allows the current practice before completion, foundation count %s',
+  async (count) => {
+    const access = {
+      exchange: true,
+      transfer: count >= 1,
+      cryptoMarketBuy: count >= 2,
+      spotProtection: count >= 3,
+      cryptoLimitBuy: count >= 5,
+      allTrading: count >= 6,
+    };
+    const spy = jest
+      .spyOn(BeginnerQuestEvidence.prototype, 'read')
+      .mockResolvedValue({ learningAccess: access } as Awaited<
+        ReturnType<BeginnerQuestEvidence['read']>
+      >);
+    for (const action of Object.keys(access) as Exclude<
+      BeginnerLearningAction,
+      'riskReduction'
+    >[]) {
+      const work = assertBeginnerLearningAccess(client, beginner, action);
+      if (access[action]) await work;
+      else
+        await expect(work).rejects.toMatchObject({
+          response: { error: { code: 'BEGINNER_FEATURE_LOCKED' } },
+          status: 403,
+        });
+    }
+    expect(spy).toHaveBeenCalledWith('beginner-a', false);
+  },
+);
+it('an evidence failure cannot grant permission', async () => {
+  jest
+    .spyOn(BeginnerQuestEvidence.prototype, 'read')
+    .mockRejectedValue(new Error('unavailable'));
+  await expect(
+    assertBeginnerLearningAccess(client, beginner, 'allTrading'),
+  ).rejects.toThrow('unavailable');
+});
+it('never mistakes sell/cancel safety for a learning prerequisite', () => {
+  for (const assetType of ['crypto', 'domestic_stock', 'us_stock'])
+    for (const orderType of ['market', 'limit'])
+      expect(beginnerOrderAction({ side: 'sell', orderType }, assetType)).toBe(
+        'riskReduction',
+      );
+  expect(
+    beginnerOrderAction({ side: 'buy', orderType: 'market' }, 'crypto'),
+  ).toBe('cryptoMarketBuy');
+  expect(
+    beginnerOrderAction({ side: 'buy', orderType: 'limit' }, 'crypto'),
+  ).toBe('cryptoLimitBuy');
+  expect(
+    beginnerOrderAction({ side: 'buy', orderType: 'market' }, 'us_stock'),
+  ).toBe('allTrading');
+});
diff --git a/backend/src/trading-accounts/beginner-learning-policy.ts b/backend/src/trading-accounts/beginner-learning-policy.ts
new file mode 100644
index 00000000..6c7745cf
--- /dev/null
+++ b/backend/src/trading-accounts/beginner-learning-policy.ts
@@ -0,0 +1,68 @@
+import { createApiError } from '../common/api-error';
+import {
+  BeginnerQuestEvidence,
+  type QuestClient,
+} from './beginner-quest-evidence';
+
+export type BeginnerLearningAction =
+  | 'exchange'
+  | 'transfer'
+  | 'cryptoMarketBuy'
+  | 'spotProtection'
+  | 'cryptoLimitBuy'
+  | 'allTrading'
+  | 'riskReduction';
+export type LearningAccount = {
+  id?: string;
+  tradingAccountId?: string;
+  mode: string;
+};
+
+const conditions: Record<
+  Exclude<BeginnerLearningAction, 'riskReduction'>,
+  string
+> = {
+  exchange: '환전하기 퀘스트에서 사용할 수 있어요.',
+  transfer: '환전하기 퀘스트를 완료하면 사용할 수 있어요.',
+  cryptoMarketBuy: '암호화폐 시장가 매수 퀘스트에서 사용할 수 있어요.',
+  spotProtection: 'TP/SL 설정 퀘스트에서 사용할 수 있어요.',
+  cryptoLimitBuy: '암호화폐 지정가 매수 퀘스트에서 사용할 수 있어요.',
+  allTrading: '암호화폐 지정가 매수 퀘스트를 완료하면 사용할 수 있어요.',
+};
+
+/** Call after ownership; commands call again inside their existing account fence.
+ * Never changes operational gates, money, replay, cancellation or exit policy. */
+export async function assertBeginnerLearningAccess(
+  client: QuestClient,
+  account: LearningAccount,
+  action: BeginnerLearningAction,
+) {
+  if (
+    account.mode !== 'beginner' ||
+    action === 'riskReduction' ||
+    action === 'exchange'
+  )
+    return;
+  const accountId = account.id ?? account.tradingAccountId;
+  if (!accountId)
+    throw createApiError(
+      'TRADING_ACCOUNT_SCOPE_MISMATCH',
+      'Account scope is required.',
+      500,
+    );
+  const { learningAccess } = await new BeginnerQuestEvidence(client).read(
+    accountId,
+    false,
+  );
+  if (!learningAccess[action])
+    throw createApiError('BEGINNER_FEATURE_LOCKED', conditions[action], 403);
+}
+
+export function beginnerOrderAction(
+  order: { side: string; orderType: string },
+  assetType: string,
+): BeginnerLearningAction {
+  if (order.side === 'sell') return 'riskReduction';
+  if (assetType !== 'crypto') return 'allTrading';
+  return order.orderType === 'market' ? 'cryptoMarketBuy' : 'cryptoLimitBuy';
+}
