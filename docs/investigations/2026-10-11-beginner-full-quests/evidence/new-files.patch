+export function isTradingQuest(key: BeginnerQuestKey): key is TradingQuestKey { return key !== 'exchange' && key !== 'transfer'; }
diff --git a/frontend/src/features/quest/tradingQuests.test.ts b/frontend/src/features/quest/tradingQuests.test.ts
