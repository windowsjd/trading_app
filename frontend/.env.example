# Optional. If omitted, the app uses local development defaults:
# - web: http://<current-web-host>:3000
# - Android emulator: http://10.0.2.2:3000
# - iOS simulator: http://localhost:3000
#
# For physical Android release/EAS builds, set this to your backend URL
# or your development machine's LAN IP.
# EXPO_PUBLIC_API_ORIGIN=http://192.168.0.10:3000
#
# Optional. If omitted, WebSocket origin is derived from EXPO_PUBLIC_API_ORIGIN.
# EXPO_PUBLIC_WS_BASE_URL=ws://192.168.0.10:3000

# Market and limit orders are standard UI features; no frontend opt-in flag.
# Automatic-execution messaging is server-authoritative through the additive
# quote/create `executionPolicy` object, so no EXPO_PUBLIC flag describes it.
# When the backend scheduler matcher is enabled the policy reports
# autoExecutionEnabled=true and the client renders the auto-fill copy;
# otherwise it reports reservation_only and renders "미체결 상태로 등록". The
# copy never claims real-time or live-exchange execution (path B fills off a
# closed 5m candle and may lag a few minutes).

# Domestic stock order book preview (crypto fixtures remain available to UI tests).
# Requires development; ignored in production. Crypto detail always uses live data.
# Crypto preview uses existing BINANCE <BASE>USDT asset symbols (BTCUSDT, ETHUSDT...).
# EXPO_PUBLIC_ORDER_BOOK_PREVIEW=false
# Optional extreme decimal strings for layout testing (requires preview above).
# EXPO_PUBLIC_ORDER_BOOK_PREVIEW_LONG=false
