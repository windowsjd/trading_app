    "bundleIdentifier": "com.leagueoftrading"
  },
  "android": {
    "package": "com.leagueoftrading",
    "blockedPermissions": [
      "com.google.android.gms.permission.AD_ID",
      "android.permission.ACCESS_ADSERVICES_AD_ID",
      "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
      "android.permission.ACCESS_ADSERVICES_TOPICS"
    ],
    "adaptiveIcon": {
      "foregroundImage": "./assets/icon/trading-class-android-foreground-432.png",
      "backgroundImage": "./assets/icon/trading-class-android-background-432.png"
    },
    "softwareKeyboardLayoutMode": "resize"
  },
  "extra": {
    "eas": {
      "projectId": "ea6190e3-80cd-43df-a7b1-d2b780f05985"
    }
  },
  "owner": "mycroft7947",
  "plugins": [
    ["react-native-google-mobile-ads", {
      "androidAppId": "ca-app-pub-7899930948413451~9002185139",
      "iosAppId": "ca-app-pub-7899930948413451~7288069200",
      "delayAppMeasurementInit": true,
      "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
    }],
    ["expo-image-picker", {
