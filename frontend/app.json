{
  "name": "트레이딩 클래스",
  "version": "1.0.3",
  "slug": "leagueoftrading",
  "icon": "./assets/icon/trading-class-ios-icon-1024.png",
  "ios": {
    "version": "1.0.4",
    "bundleIdentifier": "com.leagueoftrading",
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false,
      "LSApplicationQueriesSchemes": [
        "instagram-stories",
        "kakaotalk",
        "tg"
      ]
    }
  },
  "android": {
    "package": "com.nanghwa.tradingclass",
    "blockedPermissions": [
      "com.google.android.gms.permission.AD_ID",
      "android.permission.ACCESS_ADSERVICES_AD_ID",
      "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
      "android.permission.ACCESS_ADSERVICES_TOPICS",
      "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
    ],
    "adaptiveIcon": {
      "foregroundImage": "./assets/icon/trading-class-android-foreground-432.png",
      "backgroundImage": "./assets/icon/trading-class-android-background-432.png"
    },
    "softwareKeyboardLayoutMode": "resize"
  },
  "extra": {
    "eas": {
      "projectId": "ea6190e3-80cd-43df-a7b1-d2b780f05985"
    }
  },
  "owner": "mycroft7947",
  "plugins": [
    [
      "react-native-google-mobile-ads",
      {
        "androidAppId": "ca-app-pub-7899930948413451~9002185139",
        "iosAppId": "ca-app-pub-7899930948413451~7288069200",
        "delayAppMeasurementInit": true,
        "skAdNetworkItems": [
          "cstr6suwn9.skadnetwork"
        ]
      }
    ],
    [
      "expo-image-picker",
      {
        "photosPermission": "프로필 사진을 선택하려면 사진 접근 권한이 필요합니다.",
        "cameraPermission": false,
        "microphonePermission": false
      }
    ],
    [
      "expo-notifications",
      {
        "defaultChannel": "default"
      }
    ],
    [
      "expo-media-library",
      {
        "photosPermission": "프로필 사진을 선택하려면 사진 접근 권한이 필요합니다.",
        "savePhotosPermission": "수익 카드 이미지를 사진 앱에 저장하려면 사진 추가 권한이 필요합니다.",
        "isAccessMediaLocationEnabled": false,
        "granularPermissions": []
      }
    ]
  ],
  "scheme": "leagueoftrading",
  "userInterfaceStyle": "automatic"
}
