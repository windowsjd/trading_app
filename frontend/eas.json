{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "env": { "ADMOB_BUILD_PROFILE": "development" },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": { "ADMOB_BUILD_PROFILE": "preview" },
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": { "ADMOB_BUILD_PROFILE": "production" },
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
