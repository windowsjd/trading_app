model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  nickname        String     @unique
  profileImageUrl String?    @map("profile_image_url")
  status          UserStatus @default(active)
  role            UserRole   @default(user)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  seasonParticipants          SeasonParticipant[]
  tradingAccounts             TradingAccount[]
  fxExecuteRequests           FxExecuteRequest[]
  refreshTokenSessions        RefreshTokenSession[]
  userBadges                  UserBadge[]
  seasonRewards               SeasonReward[]
  operatorAuditLogs           OperatorAuditLog[]
  quotes                      Quote[]
  adRewardClaims              AdRewardClaim[]
  rewardFulfillmentTargets    RewardFulfillmentRequest[] @relation("RewardFulfillmentTargetUser")
  rewardFulfillmentsRequested RewardFulfillmentRequest[] @relation("RewardFulfillmentRequestedBy")
  rewardFulfillmentsProcessed RewardFulfillmentRequest[] @relation("RewardFulfillmentProcessedBy")
  rewardFulfillmentsCanceled  RewardFulfillmentRequest[] @relation("RewardFulfillmentCanceledBy")

  @@map("users")
}

model OperatorAuditLog {
  id           String              @id @default(uuid())
  actorUserId  String              @map("actor_user_id")
  actorRole    UserRole            @map("actor_role")
  action       String
  targetType   String?             @map("target_type")
  targetId     String?             @map("target_id")
  requestId    String?             @map("request_id")
  ipAddress    String?             @map("ip_address")
  userAgent    String?             @map("user_agent")
  metadataJson Json?               @map("metadata_json")
  result       OperatorAuditResult
  errorCode    String?             @map("error_code")
  createdAt    DateTime            @default(now()) @map("created_at")

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([result, createdAt])
  @@index([targetType, targetId])
  @@map("operator_audit_logs")
}

model RefreshTokenSession {
  id                  String                    @id @default(uuid())
  userId              String                    @map("user_id")
  tokenHash           String                    @unique @map("token_hash")
  status              RefreshTokenSessionStatus @default(active)
  expiresAt           DateTime                  @map("expires_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  revokedAt           DateTime?                 @map("revoked_at")
  replacedBySessionId String?                   @map("replaced_by_session_id")
  userAgent           String?                   @map("user_agent")
  ipAddress           String?                   @map("ip_address")

  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession         RefreshTokenSession?  @relation("RefreshTokenSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacementSourceSessions RefreshTokenSession[] @relation("RefreshTokenSessionReplacement")

  @@index([userId])
  @@index([status, expiresAt])
  @@map("refresh_token_sessions")
}

// Common trading-account foundation shared by season mode and the future
// general (non-season) mode. Wallets/orders/positions/exchanges/snapshots
// still reference SeasonParticipant during the transition; only the account
// identity layer lives here today. General-mode accounts are created ONLY by
// an explicit POST /api/v1/trading-accounts/general (작업 6) — never by a
// migration, a GET, or a trading path.
// initialCapitalKrw is the account's initial external grant only (10,000,000
// KRW for general accounts) — ad rewards are ledgered as WalletTransaction
// rows (txType=ad_reward) and must never mutate it.
// "At most one general account per user" is enforced by a partial unique
// index that Prisma cannot express; see the migration SQL
// (trading_accounts_general_owner_unique). status=active does not by itself
// permit season trading: Season.status/window and ParticipantStatus checks
// remain authoritative for season accounts.
model TradingAccount {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  mode              TradingAccountMode
  status            TradingAccountStatus @default(active)
  initialCapitalKrw Decimal              @map("initial_capital_krw") @db.Decimal(24, 8)
  openedAt          DateTime             @map("opened_at")
  closedAt          DateTime?            @map("closed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  seasonParticipant       SeasonParticipant?
  // Financial + trading back-relations (transitional accountId scope; rows
  // also keep their legacy seasonParticipantId until the removal work unit).
  // NO aggregate/cached value columns live here — balances, ledgers,
  // positions, and returns are always derived from the source tables.
  cashWallets             CashWallet[]
  walletTransactions      WalletTransaction[]
  exchangeTransactions    ExchangeTransaction[]
  fxExecuteRequests       FxExecuteRequest[]
  orders                  Order[]
  positions               Position[]
  quotes                  Quote[]
  adRewardClaims          AdRewardClaim[]
  equitySnapshots         EquitySnapshot[]
  dailyPortfolioSnapshots DailyPortfolioSnapshot[]
  // Season accounts only — a general account attached here is an integrity
  // violation, never a supported ranking scope (작업 8).
  seasonRankings          SeasonRanking[]

  @@index([userId, mode])
  @@index([mode, status])
  @@map("trading_accounts")
}

model Season {
  id                String       @id @default(uuid())
  name              String
  status            SeasonStatus
  startAt           DateTime     @map("start_at")
  endAt             DateTime     @map("end_at")
  initialCapitalKrw Decimal      @map("initial_capital_krw") @db.Decimal(24, 8)
  tradeFeeRate      Decimal      @map("trade_fee_rate") @db.Decimal(10, 6)
  fxFeeRate         Decimal      @map("fx_fee_rate") @db.Decimal(10, 6)
  rewardPolicyJson  Json?        @map("reward_policy_json")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  participants              SeasonParticipant[]
  seasonRankings            SeasonRanking[]
  userBadges                UserBadge[]
  seasonRewards             SeasonReward[]
  rewardFulfillmentRequests RewardFulfillmentRequest[]

  @@map("seasons")
}

model SeasonParticipant {
  id                      String            @id @default(uuid())
  seasonId                String            @map("season_id")
  userId                  String            @map("user_id")
  joinedAt                DateTime          @map("joined_at")
  participantStatus       ParticipantStatus @default(registered) @map("participant_status")
  initialCapitalKrw       Decimal           @map("initial_capital_krw") @db.Decimal(24, 8)
  totalAssetKrw           Decimal           @map("total_asset_krw") @db.Decimal(24, 8)
  totalReturnRate         Decimal           @map("total_return_rate") @db.Decimal(12, 8)
  maxDrawdown             Decimal           @map("max_drawdown") @db.Decimal(12, 8)
  totalFillCount          Int               @default(0) @map("total_fill_count")
  currentRank             Int?              @map("current_rank")
  finalRank               Int?              @map("final_rank")
  finalTier               String?           @map("final_tier")
  rewardGrantedAt         DateTime?         @map("reward_granted_at")
  excludedAt              DateTime?         @map("excluded_at")
  excludedReason          String?           @map("excluded_reason")
  excludedByUserId        String?           @map("excluded_by_user_id")
  rankingHiddenAt         DateTime?         @map("ranking_hidden_at")
  rankingHiddenReason     String?           @map("ranking_hidden_reason")
  rankingHiddenByUserId   String?           @map("ranking_hidden_by_user_id")
  resultCorrectedAt       DateTime?         @map("result_corrected_at")
  resultCorrectedReason   String?           @map("result_corrected_reason")
  resultCorrectedByUserId String?           @map("result_corrected_by_user_id")
  // Transitional nullable link to the common trading account. Backfilled for
  // all pre-existing participants by the add_trading_account_foundation
  // migration; every new join path must set it. Planned to be tightened to
  // NOT NULL in a follow-up work unit once no writer can leave it null.
  tradingAccountId        String?           @unique @map("trading_account_id")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  season                    Season                     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradingAccount            TradingAccount?            @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  cashWallets               CashWallet[]
  walletTransactions        WalletTransaction[]
  exchangeTransactions      ExchangeTransaction[]
  equitySnapshots           EquitySnapshot[]
  fxExecuteRequests         FxExecuteRequest[]
  positions                 Position[]
  orders                    Order[]
  quotes                    Quote[]
  dailyPortfolioSnapshots   DailyPortfolioSnapshot[]
  seasonRankings            SeasonRanking[]
  seasonRewards             SeasonReward[]
  rewardFulfillmentRequests RewardFulfillmentRequest[]

  @@unique([seasonId, userId])
  @@index([seasonId])
  @@index([seasonId, participantStatus])
  @@index([seasonId, rankingHiddenAt])
  @@index([userId])
  @@map("season_participants")
}

model Badge {
  id          String    @id @default(uuid())
  badgeType   BadgeType @map("badge_type")
  code        String    @unique
  name        String
  description String?
  iconUrl     String?   @map("icon_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userBadges UserBadge[]

  @@index([badgeType])
  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  badgeId   String   @map("badge_id")
  seasonId  String   @map("season_id")
  awardedAt DateTime @map("awarded_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge  Badge  @relation(fields: [badgeId], references: [id], onDelete: Restrict)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId, seasonId])
  @@index([userId, awardedAt])
  @@index([badgeId])
  @@index([seasonId])
  @@map("user_badges")
}

model SeasonReward {
  id                   String           @id @default(uuid())
  seasonId             String           @map("season_id")
  seasonParticipantId  String           @map("season_participant_id")
  userId               String           @map("user_id")
  rewardType           SeasonRewardType @map("reward_type")
  rewardCode           String           @map("reward_code")
  rewardName           String           @map("reward_name")
  rewardValueJson      Json?            @map("reward_value_json")
  fulfillmentRequestId String?          @unique @map("fulfillment_request_id")
  grantedAt            DateTime         @map("granted_at")
  createdAt            DateTime         @default(now()) @map("created_at")

  season                    Season                     @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  seasonParticipant         SeasonParticipant          @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  fulfillmentRequest        RewardFulfillmentRequest?  @relation("SeasonRewardFulfillmentRequest", fields: [fulfillmentRequestId], references: [id], onDelete: SetNull)
  rewardFulfillmentRequests RewardFulfillmentRequest[] @relation("RewardFulfillmentRequestSeasonReward")

  @@unique([seasonParticipantId, rewardCode])
  @@index([seasonId, grantedAt])
  @@index([userId, grantedAt])
  @@index([rewardType, rewardCode])
  @@index([fulfillmentRequestId])
  @@map("season_rewards")
}

model RewardFulfillmentRequest {
  id                  String                  @id @default(uuid())
  seasonId            String                  @map("season_id")
  seasonParticipantId String                  @map("season_participant_id")
  userId              String                  @map("user_id")
  rewardType          SeasonRewardType        @map("reward_type")
  rewardCode          String                  @map("reward_code")
  rewardName          String                  @map("reward_name")
  rewardValueJson     Json?                   @map("reward_value_json")
  status              RewardFulfillmentStatus @default(pending)
  seasonRewardId      String?                 @map("season_reward_id")
  idempotencyKey      String                  @map("idempotency_key")
  requestHash         String                  @map("request_hash")
  requestedByUserId   String                  @map("requested_by_user_id")
  processedByUserId   String?                 @map("processed_by_user_id")
  canceledByUserId    String?                 @map("canceled_by_user_id")
  requestedAt         DateTime                @default(now()) @map("requested_at")
  processingStartedAt DateTime?               @map("processing_started_at")
  fulfilledAt         DateTime?               @map("fulfilled_at")
  failedAt            DateTime?               @map("failed_at")
  canceledAt          DateTime?               @map("canceled_at")
  errorCode           String?                 @map("error_code")
  errorMessage        String?                 @map("error_message")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  season            Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  seasonParticipant SeasonParticipant @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  user              User              @relation("RewardFulfillmentTargetUser", fields: [userId], references: [id], onDelete: Restrict)
  seasonReward      SeasonReward?     @relation("RewardFulfillmentRequestSeasonReward", fields: [seasonRewardId], references: [id], onDelete: SetNull)
  requestedBy       User              @relation("RewardFulfillmentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  processedBy       User?             @relation("RewardFulfillmentProcessedBy", fields: [processedByUserId], references: [id], onDelete: SetNull)
  canceledBy        User?             @relation("RewardFulfillmentCanceledBy", fields: [canceledByUserId], references: [id], onDelete: SetNull)
  seasonRewards     SeasonReward[]    @relation("SeasonRewardFulfillmentRequest")

  @@unique([requestedByUserId, idempotencyKey])
  @@unique([seasonParticipantId, rewardCode])
  @@index([seasonId, status])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([seasonRewardId])
  @@index([requestedByUserId, requestedAt])
  @@map("reward_fulfillment_requests")
}

model Asset {
  id                 String       @id @default(uuid())
  symbol             String
  name               String
  market             String
  currencyCode       CurrencyCode @map("currency_code")
  priceCurrency      CurrencyCode @default(KRW) @map("price_currency")
  settlementCurrency CurrencyCode @default(KRW) @map("settlement_currency")
  assetType          AssetType    @map("asset_type")
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  priceSnapshots           AssetPriceSnapshot[]
  orderbookSnapshots       AssetOrderbookSnapshot[]
  marketCandles            MarketCandle[]
  marketCandleSyncStates   MarketCandleSyncState[]
  positions                Position[]
  orders                   Order[]
  quotes                   Quote[]
  limitOrderCandleEvidence LimitOrderCandleEvidence[]

  @@unique([market, symbol])
  @@index([assetType, market])
  @@index([isActive])
  @@map("assets")
}

model AssetPriceSnapshot {
  id              String               @id @default(uuid())
  assetId         String               @map("asset_id")
  price           Decimal              @db.Decimal(24, 8)
  priceKrw        Decimal?             @map("price_krw") @db.Decimal(24, 8)
  currencyCode    CurrencyCode         @map("currency_code")
  sourceType      AssetPriceSourceType @map("source_type")
  sourceName      String?              @map("source_name")
  sourceTimestamp DateTime?            @map("source_timestamp")
  effectiveAt     DateTime             @map("effective_at")
  capturedAt      DateTime             @map("captured_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  rawPayloadJson  Json?                @map("raw_payload_json")
  note            String?

  asset  Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  orders Order[]
  quotes Quote[]

  @@index([assetId, effectiveAt])
  @@index([assetId, capturedAt])
  @@index([sourceType, effectiveAt])
  @@map("asset_price_snapshots")
}

model AssetOrderbookSnapshot {
  id             String               @id @default(uuid())
  assetId        String               @map("asset_id")
  sourceType     AssetPriceSourceType @map("source_type")
  sourceName     String               @map("source_name")
  bidPrice       Decimal              @map("bid_price") @db.Decimal(24, 8)
  bidQuantity    Decimal?             @map("bid_quantity") @db.Decimal(24, 8)
  askPrice       Decimal              @map("ask_price") @db.Decimal(24, 8)
  askQuantity    Decimal?             @map("ask_quantity") @db.Decimal(24, 8)
  spreadBps      Decimal?             @map("spread_bps") @db.Decimal(18, 8)
  currencyCode   CurrencyCode         @map("currency_code")
  effectiveAt    DateTime             @map("effective_at")
  capturedAt     DateTime             @map("captured_at")
  rawPayloadJson Json?                @map("raw_payload_json")
  createdAt      DateTime             @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, sourceName, effectiveAt])
  @@index([assetId, capturedAt])
  @@index([sourceType, effectiveAt])
  @@map("asset_orderbook_snapshots")
}

model MarketCandle {
  id              String   @id @default(uuid())
  assetId         String   @map("asset_id")
  // Stored as a plain string instead of a Prisma enum: API interval literals
  // ("5m", "1d", "1w") start with a digit and cannot be enum identifiers, and
  // later aggregation intervals (15m/30m/1h/4h) must be addable without an
  // ALTER TYPE migration. The allowlist is enforced by MarketCandlesRepository.
  interval        String
  // Candle window is [openTime, closeTime); both are UTC instants.
  openTime        DateTime @map("open_time") @db.Timestamptz(3)
  closeTime       DateTime @map("close_time") @db.Timestamptz(3)
  open            Decimal  @db.Decimal(24, 8)
  high            Decimal  @db.Decimal(24, 8)
  low             Decimal  @db.Decimal(24, 8)
  close           Decimal  @db.Decimal(24, 8)
  volume          Decimal  @db.Decimal(24, 8)
  amount          Decimal? @db.Decimal(24, 8)
  isClosed        Boolean  @map("is_closed")
  sourceProvider  String   @map("source_provider")
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([assetId, interval, openTime])
  @@index([interval, openTime])
  @@index([isClosed, openTime])
  // Path-B candidate scan: closed 5m rows of one asset ordered by window start.
  @@index([assetId, interval, isClosed, openTime])
  @@map("market_candles")
}

// Persistent checkpoint for one candle sync run of a single asset/feed.
// `feed` is the stored interval literal ("5m", "1d", "1w") — a string for the
// same reason MarketCandle.interval is. cursorJson holds only provider-neutral
// resume state (dates/epoch cursors); credentials and raw provider payloads
// must never be stored here. Active-run uniqueness (at most one pending or
// running row per asset/feed) is enforced by a partial unique index that
// Prisma cannot express; see the migration SQL
// (market_candle_sync_states_active_unique).
model MarketCandleSyncState {
  id                   String                 @id @default(uuid())
  assetId              String                 @map("asset_id")
  feed                 String
  sourceProvider       String                 @map("source_provider")
  mode                 MarketCandleSyncMode
  status               MarketCandleSyncStatus @default(pending)
  // Target candle range, half-open [targetFrom, targetTo), UTC instants.
  targetFrom           DateTime               @map("target_from") @db.Timestamptz(3)
  targetTo             DateTime               @map("target_to") @db.Timestamptz(3)
  cursorJson           Json?                  @map("cursor_json")
  pagesFetched         Int                    @default(0) @map("pages_fetched")
  providerRowsReceived Int                    @default(0) @map("provider_rows_received")
  rowsAccepted         Int                    @default(0) @map("rows_accepted")
  rowsRejected         Int                    @default(0) @map("rows_rejected")
  rowsDuplicated       Int                    @default(0) @map("rows_duplicated")
  rowsWritten          Int                    @default(0) @map("rows_written")
  lastSuccessfulPageAt DateTime?              @map("last_successful_page_at") @db.Timestamptz(3)
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz(3)
  // Coverage completeness is independent of `status`: `completed` records that
  // the run terminated normally, while coverageComplete=true additionally
  // asserts that the provider cursor confirmed the entire half-open
  // [targetFrom, targetTo) range. Rows created before this column existed keep
  // coverageComplete=false and are never used as serving coverage evidence.
  coverageComplete     Boolean                @default(false) @map("coverage_complete")
  completionReason     String?                @map("completion_reason")
  // Half-open [coveredFrom, coveredTo) instants actually confirmed by the
  // provider cursor so far (grows monotonically while the run pages).
  coveredFrom          DateTime?              @map("covered_from") @db.Timestamptz(3)
  coveredTo            DateTime?              @map("covered_to") @db.Timestamptz(3)
  errorCode            String?                @map("error_code")
  errorMessage         String?                @map("error_message")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, feed, status])
  @@index([status, updatedAt])
  @@map("market_candle_sync_states")
}

// Operator-managed exception layer over the static per-year market calendar
// datasets (backend/src/orders/market-calendar/data). localDate is the
// exchange's local trading date (KRX: Asia/Seoul, US: America/New_York)
// stored as YYYY-MM-DD text so the exchange-local meaning never shifts with
// server/DB time zones; openTime/closeTime are exchange-local HHmmss text in
// the same canonical format the static datasets use. `regular` cancels a
// static closure/session override and forces the default session; `closed`
// forces a full-day closure; `custom` sets explicit open/close times (both
// required, open < close — enforced by CHECK constraints in the migration).
// An override never grants calendar coverage for its year: dates in years
// without a static dataset stay fail-closed (calendar_unavailable). Rows are
// deactivated (isActive=false) instead of deleted to preserve operational
// history.
model MarketSessionOverride {
  id              String                    @id @default(uuid())
  market          MarketCalendarMarket
  localDate       String                    @map("local_date")
  overrideType    MarketSessionOverrideType @map("override_type")
  openTime        String?                   @map("open_time")
  closeTime       String?                   @map("close_time")
  reason          String
  source          String?
  isActive        Boolean                   @default(true) @map("is_active")
  createdByUserId String                    @map("created_by_user_id")
  updatedByUserId String                    @map("updated_by_user_id")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  @@unique([market, localDate])
  @@index([isActive, market, localDate])
  @@index([localDate])
  @@map("market_session_overrides")
}

model Position {
  id                  String       @id @default(uuid())
  seasonParticipantId String       @map("season_participant_id")
  // Transitional dual identity (see CashWallet): nullable trading-account
  // scope next to the legacy seasonParticipantId. Backfilled from the
  // participant link by add_trading_scope_and_fx_legacy_partial_unique;
  // every new writer sets BOTH. NOT NULL tightening is a later work unit.
  tradingAccountId    String?      @map("trading_account_id")
  assetId             String       @map("asset_id")
  quantity            Decimal      @db.Decimal(24, 8)
  averageCost         Decimal      @map("average_cost") @db.Decimal(24, 8)
  currencyCode        CurrencyCode @map("currency_code")
  realizedPnl         Decimal      @default(0) @map("realized_pnl") @db.Decimal(24, 8)
  realizedPnlKrw      Decimal      @default(0) @map("realized_pnl_krw") @db.Decimal(24, 8)
  currentPriceLocal   Decimal?     @map("current_price_local") @db.Decimal(24, 8)
  currentPriceKrw     Decimal?     @map("current_price_krw") @db.Decimal(24, 8)
  marketValueLocal    Decimal?     @map("market_value_local") @db.Decimal(24, 8)
  marketValueKrw      Decimal?     @map("market_value_krw") @db.Decimal(24, 8)
  unrealizedPnlLocal  Decimal?     @map("unrealized_pnl_local") @db.Decimal(24, 8)
  unrealizedPnlKrw    Decimal?     @map("unrealized_pnl_krw") @db.Decimal(24, 8)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  seasonParticipant SeasonParticipant @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount    TradingAccount?   @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([seasonParticipantId, assetId])
  // One aggregate position per asset per trading account. NULL legacy rows
  // stay allowed (PostgreSQL treats NULLs as distinct in unique indexes).
  @@unique([tradingAccountId, assetId])
  @@index([seasonParticipantId])
  @@index([tradingAccountId])
  @@index([assetId])
  @@map("positions")
}

model Order {
  id                         String       @id @default(uuid())
  seasonParticipantId        String       @map("season_participant_id")
  // Transitional dual identity (see CashWallet). The trading account is the
  // asset-isolation boundary for order data; the participant link stays for
  // season state/ranking/settlement until the removal work unit.
  tradingAccountId           String?      @map("trading_account_id")
  assetId                    String       @map("asset_id")
  quoteId                    String?      @unique @map("quote_id")
  side                       OrderSide
  orderType                  OrderType    @map("order_type")
  status                     OrderStatus  @default(submitted)
  quantity                   Decimal      @db.Decimal(24, 8)
  limitPrice                 Decimal?     @map("limit_price") @db.Decimal(24, 8)
  executedPrice              Decimal?     @map("executed_price") @db.Decimal(24, 8)
  currencyCode               CurrencyCode @map("currency_code")
  grossAmount                Decimal?     @map("gross_amount") @db.Decimal(24, 8)
  feeAmount                  Decimal?     @map("fee_amount") @db.Decimal(24, 8)
  netAmount                  Decimal?     @map("net_amount") @db.Decimal(24, 8)
  assetPriceSnapshotId       String?      @map("asset_price_snapshot_id")
  fxRateSnapshotId           String?      @map("fx_rate_snapshot_id")
  idempotencyKey             String?      @map("idempotency_key")
  requestHash                String?      @map("request_hash")
  responsePayloadJson        Json?        @map("response_payload_json")
  // Limit-buy reservation bookkeeping (null for market orders): the cash
  // amount locked at submit time, the fee rate captured for the future
  // execution phase, and when the reservation was released (cancel/cleanup).
  reservedAmount             Decimal?     @map("reserved_amount") @db.Decimal(24, 8)
  reservationFeeRate         Decimal?     @map("reservation_fee_rate") @db.Decimal(10, 6)
  reservationReleasedAt      DateTime?    @map("reservation_released_at")
  cancelReason               String?      @map("cancel_reason")
  // Closed-candle evidence link (spec §7 model, preserved at the schema level
  // for the future scheduler-based matching). No code writes it today.
  limitOrderCandleEvidenceId String?      @map("limit_order_candle_evidence_id")
  submittedAt                DateTime     @map("submitted_at")
  executedAt                 DateTime?    @map("executed_at")
  canceledAt                 DateTime?    @map("canceled_at")
  rejectedAt                 DateTime?    @map("rejected_at")
  rejectReason               String?      @map("reject_reason")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  seasonParticipant  SeasonParticipant         @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount     TradingAccount?           @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  asset              Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  quote              Quote?                    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  assetPriceSnapshot AssetPriceSnapshot?       @relation(fields: [assetPriceSnapshotId], references: [id], onDelete: Restrict)
  fxRateSnapshot     FxRateSnapshot?           @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict)
  candleEvidence     LimitOrderCandleEvidence? @relation(fields: [limitOrderCandleEvidenceId], references: [id], onDelete: Restrict)

  @@unique([seasonParticipantId, idempotencyKey])
  // Account-scoped create idempotency: the same key may be reused by the
  // SAME user on a different trading account. NULL legacy rows stay allowed;
  // idempotencyKey stays nullable with its existing meaning.
  @@unique([tradingAccountId, idempotencyKey])
  @@index([seasonParticipantId, submittedAt])
  @@index([seasonParticipantId, status])
  @@index([tradingAccountId, submittedAt])
  @@index([tradingAccountId, status])
  @@index([assetId])
  @@index([quoteId])
  @@index([assetPriceSnapshotId])
  @@index([fxRateSnapshotId])
  @@index([submittedAt])
  @@index([status])
  @@index([limitOrderCandleEvidenceId])
  @@map("orders")
}

model CashWallet {
  id                  String       @id @default(uuid())
  // NULL for general-mode wallets, which have no SeasonParticipant at all
  // (작업 6). Season wallets keep their existing non-null link unchanged;
  // nothing in the general-account path ever fabricates a participant.
  seasonParticipantId String?      @map("season_participant_id")
  // Transitional dual identity: nullable trading-account scope added next to
  // the legacy seasonParticipantId. Backfilled from the participant link by
  // the add_financial_trading_account_scope migration; every new writer sets
  // BOTH. Tightened to NOT NULL only in a follow-up work unit. General
  // wallets are ALWAYS created with a non-null tradingAccountId.
  tradingAccountId    String?      @map("trading_account_id")
  currencyCode        CurrencyCode @map("currency_code")
  balanceAmount       Decimal      @map("balance_amount") @db.Decimal(24, 8)
  // Cash locked by submitted limit-buy orders. Never subtracted from total
  // asset valuation; availableAmount (= balance - reserved) is derived at
  // read time and is the ceiling for every ordinary cash debit.
  reservedAmount      Decimal      @default(0) @map("reserved_amount") @db.Decimal(24, 8)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  seasonParticipant  SeasonParticipant?  @relation(fields: [seasonParticipantId], references: [id], onDelete: Cascade)
  tradingAccount     TradingAccount?     @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  walletTransactions WalletTransaction[]

  @@unique([seasonParticipantId, currencyCode])
  // One wallet per currency per account; NULL legacy rows stay allowed
  // (PostgreSQL treats NULLs as distinct in unique indexes).
  @@unique([tradingAccountId, currencyCode])
  @@index([seasonParticipantId])
  @@index([tradingAccountId])
  @@map("cash_wallets")
}

model WalletTransaction {
  id                  String                         @id @default(uuid())
  // NULL for general-mode ledger rows (작업 6): a general account has no
  // SeasonParticipant. Season ledger rows keep their existing link.
  seasonParticipantId String?                        @map("season_participant_id")
  // Transitional dual identity (see CashWallet). Stored directly on the
  // ledger row — account-level ledger reads/audits/aggregations must not
  // depend on walking the wallet relation.
  tradingAccountId    String?                        @map("trading_account_id")
  walletId            String                         @map("wallet_id")
  currencyCode        CurrencyCode                   @map("currency_code")
  direction           WalletTransactionDirection
  txType              WalletTransactionType          @map("tx_type")
  referenceType       WalletTransactionReferenceType @map("reference_type")
  referenceId         String?                        @map("reference_id")
  amount              Decimal                        @db.Decimal(24, 8)
  balanceAfter        Decimal                        @map("balance_after") @db.Decimal(24, 8)
  occurredAt          DateTime                       @map("occurred_at")
  createdAt           DateTime                       @default(now()) @map("created_at")

  seasonParticipant SeasonParticipant? @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount    TradingAccount?    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  wallet            CashWallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  adRewardClaim     AdRewardClaim?

  // NO global @@unique([referenceType, referenceId]): one order or one
  // exchange legitimately produces several ledger rows. Single-row
  // references are protected by PARTIAL unique indexes instead, which
  // Prisma's DSL cannot express — see the
  // add_general_account_and_ad_reward_foundation migration:
  //   wallet_transactions_general_account_open_reference_unique
  //     UNIQUE (reference_id) WHERE reference_type = 'general_account_open'
  //   wallet_transactions_ad_reward_claim_reference_unique
  //     UNIQUE (reference_id) WHERE reference_type = 'ad_reward_claim'
  @@index([seasonParticipantId, occurredAt])
  @@index([tradingAccountId, occurredAt])
  // External-funding aggregation for general accounts filters by txType
  // (initial_grant / ad_reward) within an account.
  @@index([tradingAccountId, txType, occurredAt])
  @@index([walletId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

/// Rewarded-ad funding events for GENERAL-mode accounts only.
///
/// A claim row is created ONLY after a registered server-side verifier
/// accepted the ad proof: providerEventId is the verifier's identifier, never
/// a client-supplied string, and rewardAmountKrw always comes from server
/// configuration. verificationFingerprint stores a one-way SHA-256 digest of
/// the proof — never the proof, provider token, signing secret, or raw
/// callback body. verificationMetadataJson holds only the non-sensitive
/// fields the adapter explicitly allowed.
///
/// Cumulative ad funding is DERIVED (sum of granted claims / ad_reward ledger
/// rows); no aggregate column lives on TradingAccount, and a reward never
/// changes TradingAccount.initialCapitalKrw.
model AdRewardClaim {
  id                       String              @id @default(uuid())
  userId                   String              @map("user_id")
  tradingAccountId         String              @map("trading_account_id")
  provider                 String
  providerEventId          String              @map("provider_event_id")
  status                   AdRewardClaimStatus
  rewardAmountKrw          Decimal             @map("reward_amount_krw") @db.Decimal(24, 8)
  verificationFingerprint  String?             @map("verification_fingerprint")
  verificationMetadataJson Json?               @map("verification_metadata_json")
  requestedAt              DateTime            @map("requested_at")
  verifiedAt               DateTime?           @map("verified_at")
  grantedAt                DateTime?           @map("granted_at")
  rejectedAt               DateTime?           @map("rejected_at")
  failedAt                 DateTime?           @map("failed_at")
  failureCode              String?             @map("failure_code")
  failureReason            String?             @map("failure_reason")
  /// Set only for granted claims; 1:1 with the ad_reward ledger row.
  walletTransactionId      String?             @unique @map("wallet_transaction_id")
  /// COMMAND idempotency (작업 6 보완). Distinct from (provider,
  /// providerEventId): that one stops the same AD EVENT from paying twice,
  /// this one lets a client safely RETRY the same request without another
  /// verifier round trip. Nullable so pre-작업 7 rows stay valid; PostgreSQL
  /// treats NULLs as distinct, so only keyed claims are constrained.
  idempotencyKey           String?             @map("idempotency_key")
  /// sha256 over (api version, provider, proof fingerprint). Same key +
  /// different hash is AD_REWARD_IDEMPOTENCY_CONFLICT. The raw proof is never
  /// an input to anything stored.
  requestHash              String?             @map("request_hash")
  /// The first committed success/refusal payload, replayed verbatim on retry.
  responsePayloadJson      Json?               @map("response_payload_json")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  tradingAccount    TradingAccount     @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  /// The duplicate-payout guard: one provider event can be granted once.
  @@unique([provider, providerEventId])
  /// The command-retry guard. Deliberately SEPARATE from the guard above —
  /// they protect different things and must never be merged.
  @@unique([tradingAccountId, idempotencyKey])
  @@index([tradingAccountId, grantedAt])
  @@index([tradingAccountId, createdAt])
  @@index([userId, grantedAt])
  @@index([status, createdAt])
  @@map("ad_reward_claims")
}

model ExchangeTransaction {
  id                  String       @id @default(uuid())
  seasonParticipantId String       @map("season_participant_id")
  // Transitional dual identity (see CashWallet).
  tradingAccountId    String?      @map("trading_account_id")
  fxRateSnapshotId    String?      @map("fx_rate_snapshot_id")
  fromCurrency        CurrencyCode @map("from_currency")
  toCurrency          CurrencyCode @map("to_currency")
  sourceAmount        Decimal      @map("source_amount") @db.Decimal(24, 8)
  grossTargetAmount   Decimal      @map("gross_target_amount") @db.Decimal(24, 8)
  feeRate             Decimal      @map("fee_rate") @db.Decimal(10, 6)
  feeAmount           Decimal      @map("fee_amount") @db.Decimal(24, 8)
  feeCurrency         CurrencyCode @map("fee_currency")
  appliedRate         Decimal      @map("applied_rate") @db.Decimal(18, 8)
  netTargetAmount     Decimal      @map("net_target_amount") @db.Decimal(24, 8)
  executedAt          DateTime     @map("executed_at")
  createdAt           DateTime     @default(now()) @map("created_at")

  seasonParticipant SeasonParticipant  @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount    TradingAccount?    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  fxRateSnapshot    FxRateSnapshot?    @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict)
  fxExecuteRequests FxExecuteRequest[]

  @@index([seasonParticipantId, executedAt])
  @@index([tradingAccountId, executedAt])
  @@index([fxRateSnapshotId])
  @@index([fromCurrency, toCurrency, executedAt])
  @@map("exchange_transactions")
}

model FxRateSnapshot {
  id               String           @id @default(uuid())
  baseCurrency     CurrencyCode     @map("base_currency")
  quoteCurrency    CurrencyCode     @map("quote_currency")
  rate             Decimal          @db.Decimal(18, 8)
  sourceType       FxRateSourceType @map("source_type")
  sourceName       String?          @map("source_name")
  sourceTimestamp  DateTime?        @map("source_timestamp")
  effectiveAt      DateTime         @map("effective_at")
  capturedAt       DateTime         @map("captured_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  rawPayloadJson   Json?            @map("raw_payload_json")
  approvedByUserId String?          @map("approved_by_user_id")
  note             String?

  exchangeTransactions ExchangeTransaction[]
  orders               Order[]
  quotes               Quote[]

  @@index([baseCurrency, quoteCurrency, effectiveAt])
  @@index([baseCurrency, quoteCurrency, capturedAt])
  @@index([sourceType, effectiveAt])
  @@map("fx_rate_snapshots")
}

model Quote {
  id                   String        @id @default(uuid())
  userId               String        @map("user_id")
  seasonParticipantId  String?       @map("season_participant_id")
  // Transitional dual identity (see CashWallet). A quote is not an asset
  // mutation but grants later execution authority, so it carries the same
  // account isolation: order/FX execution refuses quotes whose account
  // differs, and only NULL legacy quotes pass the explicit legacy checks.
  tradingAccountId     String?       @map("trading_account_id")
  quoteType            QuoteType     @map("quote_type")
  status               QuoteStatus   @default(active)
  assetId              String?       @map("asset_id")
  side                 OrderSide?
  orderType            OrderType?    @map("order_type")
  quantity             Decimal?      @db.Decimal(24, 8)
  limitPrice           Decimal?      @map("limit_price") @db.Decimal(24, 8)
  fromCurrency         CurrencyCode? @map("from_currency")
  toCurrency           CurrencyCode? @map("to_currency")
  sourceAmount         Decimal?      @map("source_amount") @db.Decimal(24, 8)
  targetAmount         Decimal?      @map("target_amount") @db.Decimal(24, 8)
  currencyCode         CurrencyCode? @map("currency_code")
  quotedPrice          Decimal?      @map("quoted_price") @db.Decimal(24, 8)
  quotedRate           Decimal?      @map("quoted_rate") @db.Decimal(18, 8)
  // Limit-buy reservation basis pinned AT QUOTE TIME (null on market/FX
  // quotes). Create reserves exactly these amounts, so a Season.tradeFeeRate
  // change between quote and create can never move the user's reservation.
  quotedFeeRate        Decimal?      @map("quoted_fee_rate") @db.Decimal(10, 6)
  quotedGrossAmount    Decimal?      @map("quoted_gross_amount") @db.Decimal(24, 8)
  quotedFeeAmount      Decimal?      @map("quoted_fee_amount") @db.Decimal(24, 8)
  quotedReservedAmount Decimal?      @map("quoted_reserved_amount") @db.Decimal(24, 8)
  assetPriceSnapshotId String?       @map("asset_price_snapshot_id")
  fxRateSnapshotId     String?       @map("fx_rate_snapshot_id")
  assetPriceSourceJson Json?         @map("asset_price_source_json")
  fxRateSourceJson     Json?         @map("fx_rate_source_json")
  maxChangeBps         Decimal       @map("max_change_bps") @db.Decimal(10, 4)
  expiresAt            DateTime      @map("expires_at")
  requestHash          String        @map("request_hash")
  consumedAt           DateTime?     @map("consumed_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  seasonParticipant  SeasonParticipant?  @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount     TradingAccount?     @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assetPriceSnapshot AssetPriceSnapshot? @relation(fields: [assetPriceSnapshotId], references: [id], onDelete: Restrict)
  fxRateSnapshot     FxRateSnapshot?     @relation(fields: [fxRateSnapshotId], references: [id], onDelete: Restrict)
  orders             Order[]

  @@index([userId, createdAt])
  @@index([seasonParticipantId, createdAt])
  @@index([tradingAccountId, createdAt])
  @@index([tradingAccountId, status, expiresAt])
  @@index([quoteType, status, expiresAt])
  @@index([requestHash])
  @@index([assetId, createdAt])
  @@index([fxRateSnapshotId])
  @@index([assetPriceSnapshotId])
  @@map("quotes")
}

model FxExecuteRequest {
  id                    String                 @id @default(uuid())
  userId                String                 @map("user_id")
  seasonParticipantId   String                 @map("season_participant_id")
  // Transitional dual identity (see CashWallet).
  tradingAccountId      String?                @map("trading_account_id")
  idempotencyKey        String                 @map("idempotency_key")
  requestHash           String                 @map("request_hash")
  fromCurrency          CurrencyCode           @map("from_currency")
  toCurrency            CurrencyCode           @map("to_currency")
  sourceAmount          Decimal                @map("source_amount") @db.Decimal(24, 8)
  status                FxExecuteRequestStatus
  exchangeTransactionId String?                @map("exchange_transaction_id")
  responsePayloadJson   Json?                  @map("response_payload_json")
  errorCode             String?                @map("error_code")
  errorMessage          String?                @map("error_message")
  requestedAt           DateTime               @map("requested_at")
  completedAt           DateTime?              @map("completed_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  seasonParticipant   SeasonParticipant    @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount      TradingAccount?      @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)
  exchangeTransaction ExchangeTransaction? @relation(fields: [exchangeTransactionId], references: [id], onDelete: Restrict)

  // Account-scoped idempotency: the SAME user may reuse a key across two
  // different trading accounts (e.g. a season and a future general account);
  // within one account the key stays unique. NULL legacy rows stay allowed.
  //
  // The former global per-user unique on (userId, idempotencyKey) was
  // REPLACED by a PostgreSQL partial unique index protecting ONLY legacy
  // rows: UNIQUE (user_id, idempotency_key) WHERE trading_account_id IS
  // NULL. Prisma's schema DSL cannot express partial unique indexes, so it
  // lives only in the add_trading_scope_and_fx_legacy_partial_unique
  // migration (fx_execute_requests_user_id_idempotency_key_legacy_null_key)
  // and is asserted by the schema contract tests.
  @@unique([tradingAccountId, idempotencyKey])
  @@index([seasonParticipantId, requestedAt])
  @@index([tradingAccountId, requestedAt])
  @@index([status, requestedAt])
  @@index([exchangeTransactionId])
  @@map("fx_execute_requests")
}

/// Point-in-time equity/performance record.
///
/// SEASON rows keep their historical meaning: returnRate is the simple
/// initial-capital return and the general-performance columns stay NULL.
/// GENERAL rows (작업 7) have no SeasonParticipant at all and carry the
/// time-weighted performance state instead — returnRate is the TWR percent,
/// i.e. (timeWeightedReturnFactor - 1) * 100. The two meanings are never
/// mixed; API responses always name which one applies via returnRateMethod.
///
/// timeWeightedReturnFactor is the SOURCE OF TRUTH for general performance;
/// returnRate is a rounded presentation of it and is never fed back into the
/// next factor calculation.
model EquitySnapshot {
  id                           String                          @id @default(uuid())
  /// NULL for general-mode snapshots (no participant exists).
  seasonParticipantId          String?                         @map("season_participant_id")
  /// Transitional dual identity: backfilled for existing season rows, always
  /// written by new writers, and the ONLY scope a general row has.
  tradingAccountId             String?                         @map("trading_account_id")
  totalAssetKrw                Decimal                         @map("total_asset_krw") @db.Decimal(24, 8)
  returnRate                   Decimal                         @map("return_rate") @db.Decimal(12, 8)
  krwCash                      Decimal                         @map("krw_cash") @db.Decimal(24, 8)
  usdCashKrw                   Decimal                         @map("usd_cash_krw") @db.Decimal(24, 8)
  domesticStockValueKrw        Decimal                         @map("domestic_stock_value_krw") @db.Decimal(24, 8)
  usStockValueKrw              Decimal                         @map("us_stock_value_krw") @db.Decimal(24, 8)
  cryptoValueKrw               Decimal                         @map("crypto_value_krw") @db.Decimal(24, 8)
  snapshotReason               SnapshotReason                  @map("snapshot_reason")
  // ---- general-mode performance state (NULL on season rows) ----
  /// initial_grant + ad_reward inflows to date. Never a guess: only the two
  /// explicitly external ledger reference types count.
  cumulativeExternalFundingKrw Decimal?                        @map("cumulative_external_funding_krw") @db.Decimal(24, 8)
  /// totalAssetKrw - cumulativeExternalFundingKrw.
  investmentPnlKrw             Decimal?                        @map("investment_pnl_krw") @db.Decimal(24, 8)
  /// Cumulative time-weighted return factor (1 = flat). High precision so
  /// chained segments do not drift.
  timeWeightedReturnFactor     Decimal?                        @map("time_weighted_return_factor") @db.Decimal(38, 18)
  // ---- external-funding boundary (set ONLY on the before/after pair and on
  // the general_account_open origin) ----
  externalFundingAmountKrw     Decimal?                        @map("external_funding_amount_krw") @db.Decimal(24, 8)
  externalFundingReferenceType WalletTransactionReferenceType? @map("external_funding_reference_type")
  externalFundingReferenceId   String?                         @map("external_funding_reference_id")
  capturedAt                   DateTime                        @map("captured_at")
  createdAt                    DateTime                        @default(now()) @map("created_at")

  seasonParticipant SeasonParticipant? @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount    TradingAccount?    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)

  // A boundary snapshot exists at most once per (account, reference, phase).
  // Prisma CAN express this one as a plain composite unique because all four
  // columns are nullable and PostgreSQL treats NULLs as distinct, so ordinary
  // season/ordinary rows are unaffected.
  @@unique([tradingAccountId, externalFundingReferenceType, externalFundingReferenceId, snapshotReason], name: "equity_snapshot_external_funding_boundary")
  @@index([seasonParticipantId, capturedAt])
  @@index([tradingAccountId, capturedAt])
  @@index([tradingAccountId, snapshotReason, capturedAt])
  @@index([externalFundingReferenceType, externalFundingReferenceId])
  @@index([snapshotReason, capturedAt])
  @@map("equity_snapshots")
}

/// One row per subject per calendar day. Same season/general split as
/// EquitySnapshot: returnRate is the initial-capital return for season rows
/// and the TWR percent for general rows.
model DailyPortfolioSnapshot {
  id                           String   @id @default(uuid())
  /// NULL for general-mode snapshots (no participant exists).
  seasonParticipantId          String?  @map("season_participant_id")
  tradingAccountId             String?  @map("trading_account_id")
  snapshotDate                 DateTime @map("snapshot_date") @db.Date
  totalAssetKrw                Decimal  @map("total_asset_krw") @db.Decimal(24, 8)
  returnRate                   Decimal  @map("return_rate") @db.Decimal(12, 8)
  krwCash                      Decimal  @map("krw_cash") @db.Decimal(24, 8)
  usdCashKrw                   Decimal  @map("usd_cash_krw") @db.Decimal(24, 8)
  assetValueKrw                Decimal  @map("asset_value_krw") @db.Decimal(24, 8)
  realizedPnlKrw               Decimal  @map("realized_pnl_krw") @db.Decimal(24, 8)
  unrealizedPnlKrw             Decimal  @map("unrealized_pnl_krw") @db.Decimal(24, 8)
  // ---- general-mode performance state (NULL on season rows) ----
  cumulativeExternalFundingKrw Decimal? @map("cumulative_external_funding_krw") @db.Decimal(24, 8)
  investmentPnlKrw             Decimal? @map("investment_pnl_krw") @db.Decimal(24, 8)
  timeWeightedReturnFactor     Decimal? @map("time_weighted_return_factor") @db.Decimal(38, 18)
  capturedAt                   DateTime @map("captured_at")
  createdAt                    DateTime @default(now()) @map("created_at")

  seasonParticipant SeasonParticipant? @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount    TradingAccount?    @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)

  @@unique([seasonParticipantId, snapshotDate])
  /// One daily row per account per date; NULL legacy rows stay allowed.
  @@unique([tradingAccountId, snapshotDate])
  @@index([snapshotDate])
  @@index([seasonParticipantId, capturedAt])
  @@index([tradingAccountId, capturedAt])
  @@index([tradingAccountId, snapshotDate])
  @@map("daily_portfolio_snapshots")
}

model SeasonRanking {
  id                  String            @id @default(uuid())
  seasonId            String            @map("season_id")
  seasonParticipantId String            @map("season_participant_id")
  // Transitional SECOND identity (작업 8). SeasonRanking stays a season-only
  // model — the participant relation is NOT relaxed — and this column exists
  // to make the row's asset-isolation scope explicit and verifiable. Nullable
  // only until every legacy row is repaired; NOT NULL is a later hardening
  // unit. A general-mode account must NEVER appear here.
  tradingAccountId    String?           @map("trading_account_id")
  rankType            SeasonRankingType @default(daily) @map("rank_type")
  rank                Int
  totalAssetKrw       Decimal           @map("total_asset_krw") @db.Decimal(24, 8)
  returnRate          Decimal           @map("return_rate") @db.Decimal(12, 8)
  maxDrawdown         Decimal           @default(0) @map("max_drawdown") @db.Decimal(12, 8)
  totalFillCount      Int               @default(0) @map("total_fill_count")
  reachedReturnAt     DateTime?         @map("reached_return_at")
  rankingDate         DateTime          @map("ranking_date") @db.Date
  capturedAt          DateTime          @map("captured_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  season            Season            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  seasonParticipant SeasonParticipant @relation(fields: [seasonParticipantId], references: [id], onDelete: Restrict)
  tradingAccount    TradingAccount?   @relation(fields: [tradingAccountId], references: [id], onDelete: Restrict)

  @@unique([seasonId, rankType, rankingDate, seasonParticipantId])
  @@unique([seasonId, rankType, rankingDate, rank])
  // One ranking row per ACCOUNT per (season, rankType, date), the account-scoped
  // twin of the participant unique. NULLs are distinct in PostgreSQL, so legacy
  // unrepaired rows are unaffected.
  @@unique([seasonId, rankType, rankingDate, tradingAccountId])
  @@index([seasonId, rankType, rankingDate, rank])
  @@index([seasonParticipantId, rankingDate])
  @@index([tradingAccountId, rankingDate])
  @@map("season_rankings")
}

model BatchJobRun {
  id                 String         @id @default(uuid())
  jobName            String         @map("job_name")
  idempotencyKey     String         @map("idempotency_key")
  status             BatchJobStatus @default(pending)
  dryRun             Boolean        @default(false) @map("dry_run")
  startedAt          DateTime?      @map("started_at")
  finishedAt         DateTime?      @map("finished_at")
  requestedBy        String?        @map("requested_by")
  requestPayloadJson Json?          @map("request_payload_json")
  resultPayloadJson  Json?          @map("result_payload_json")
  errorCode          String?        @map("error_code")
  errorMessage       String?        @map("error_message")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@unique([jobName, idempotencyKey])
  @@index([jobName, status])
  @@index([jobName, createdAt])
  @@index([status, createdAt])
  @@map("batch_job_runs")
}

model OpsJobRun {
  id             String          @id @default(uuid())
  jobName        OpsJobName      @map("job_name")
  status         OpsJobRunStatus
  trigger        OpsJobTrigger
  requestedBy    String?         @map("requested_by")
  startedAt      DateTime        @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  durationMs     Int?            @map("duration_ms")
  lockKey        String?         @map("lock_key")
  idempotencyKey String?         @map("idempotency_key")
  dryRun         Boolean         @default(false) @map("dry_run")
  attempt        Int             @default(1)
  maxAttempts    Int             @default(1) @map("max_attempts")
  errorCode      String?         @map("error_code")
  errorMessage   String?         @map("error_message")
  resultJson     Json?           @map("result_json")
  metadataJson   Json?           @map("metadata_json")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([jobName, idempotencyKey])
  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@index([trigger, startedAt])
  @@index([lockKey])
  @@map("ops_job_runs")
}

model OpsJobLock {
  id         String     @id @default(uuid())
  lockKey    String     @unique @map("lock_key")
  jobName    OpsJobName @map("job_name")
  ownerId    String     @map("owner_id")
  acquiredAt DateTime   @map("acquired_at")
  expiresAt  DateTime   @map("expires_at")
  releasedAt DateTime?  @map("released_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([jobName, expiresAt])
  @@index([expiresAt])
  @@map("ops_job_locks")
}

// Closed-candle trigger evidence (spec §7 model). One row per candle is shared
// by every order the candle fills — the candle IS the evidence, and the
// duplicated columns keep the fill reason reproducible even after retention
// removes the candle row. Deliberately NOT foreign-keyed to market_candles:
// evidence must outlive the candle (§18), so market_candle_id is a plain
// denormalized reference. Identity is (asset, interval, window, provider), so
// one row is shared by every order the same closed 5m candle fills. The actual
// per-order fill price is the ORDER's limitPrice (Order.executedPrice); this
// row only records that the limit was touched and the fill-price policy.
model LimitOrderCandleEvidence {
  id                   String   @id @default(uuid())
  // Denormalized reference to the candle that proved the touch (no FK — the
  // candle may be retention-deleted while this evidence lives on).
  marketCandleId       String   @map("market_candle_id")
  assetId              String   @map("asset_id")
  interval             String
  openTime             DateTime @map("open_time") @db.Timestamptz(3)
  closeTime            DateTime @map("close_time") @db.Timestamptz(3)
  triggerLowPrice      Decimal  @map("trigger_low_price") @db.Decimal(24, 8)
  // Always 'limit_price': a 5m low proves the limit was touched, never the
  // price a fill could actually have been obtained at.
  executionPricePolicy String   @map("execution_price_policy")
  provider             String
  sourceName           String   @map("source_name")
  sourceUpdatedAt      DateTime @map("source_updated_at") @db.Timestamptz(3)
  finalizedAt          DateTime @map("finalized_at") @db.Timestamptz(3)
  policyVersion        Int      @map("policy_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset  Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  orders Order[]

  @@unique([assetId, interval, openTime, provider], map: "limit_order_candle_evidences_asset_interval_open_provider_key")
  @@index([assetId, openTime])
  @@map("limit_order_candle_evidences")
}
