generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
  deleted
}

enum UserRole {
  user
  operator
  admin
}

enum RefreshTokenSessionStatus {
  active
  revoked
}

enum SeasonStatus {
  upcoming
  active
  ended
  settled
}

enum ParticipantStatus {
  registered
  active
  finished
  rewarded
  excluded
}

enum TradingAccountMode {
  season
  general
}

enum TradingAccountStatus {
  active
  suspended
  closed
}

enum CurrencyCode {
  KRW
  USD
}

enum WalletTransactionDirection {
  credit
  debit
}

enum WalletTransactionType {
  initial_grant
  exchange_source
  exchange_target
  order_buy
  order_sell
  fee
  adjustment
  settlement
  // External virtual-funding inflow earned by watching a rewarded ad. NOT an
  // investment return: return/PnL work units must exclude it from trading
  // performance and treat it like a deposit.
  ad_reward
}

enum WalletTransactionReferenceType {
  season_join
  exchange_transaction
  order
  manual_adjustment
  settlement
  // referenceId = the general TradingAccount id. Exactly one such ledger row
  // may exist per account (partial unique index, see the
  // add_general_account_and_ad_reward_foundation migration).
  general_account_open
  // referenceId = AdRewardClaim.id, one ledger row per granted claim
  // (partial unique index; claim.walletTransactionId is the reverse link).
  ad_reward_claim
}

enum AdRewardClaimStatus {
  pending
  verified
  granted
  rejected
  failed
}

enum SnapshotReason {
  season_join
  exchange_executed
  order_executed
  scheduled
  settlement
  // General-mode performance origins and external-funding boundaries (작업 7).
  // general_account_open      — the origin snapshot written in the same
  //                             transaction as a new general account.
  // performance_baseline      — an origin created for a PRE-작업 7 general
  //                             account by the explicit operational backfill.
  // external_funding_before /
  // external_funding_after    — the pair bracketing an external virtual-funding
  //                             inflow (ad reward), so the inflow itself moves
  //                             neither the TWR factor nor investment PnL.
  general_account_open
  performance_baseline
  external_funding_before
  external_funding_after
}

enum FxRateSourceType {
  official_batch
  provider_api
  admin_manual
}

enum FxExecuteRequestStatus {
