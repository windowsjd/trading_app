NODE_ENV=development
PORT=3000
CORS_ORIGINS=

DATABASE_URL=postgresql://trading_app:trading_app_pw@localhost:5432/trading_app?schema=public
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=1000

# Candle response cache (Redis). Disabled by default: the cache layer exists but
# is not yet wired into the candles endpoint, so enabling it has no effect on
# provider call volume in this step. A later serving step turns it on.
CANDLE_CACHE_ENABLED=false
CANDLE_CACHE_MAX_PAYLOAD_BYTES=2097152
CANDLE_CACHE_CURRENT_STALE_TTL_SECONDS=300
CANDLE_CACHE_HISTORICAL_FRESH_TTL_SECONDS=900
CANDLE_CACHE_HISTORICAL_STALE_TTL_SECONDS=3600
CANDLE_CACHE_EMPTY_FRESH_TTL_SECONDS=10
CANDLE_CACHE_EMPTY_STALE_TTL_SECONDS=60
CANDLE_SINGLE_FLIGHT_LOCK_TTL_MS=30000
CANDLE_SINGLE_FLIGHT_WAIT_TIMEOUT_MS=35000
CANDLE_SINGLE_FLIGHT_POLL_INTERVAL_MS=100
CANDLE_SINGLE_FLIGHT_RENEW_INTERVAL_MS=10000
# database (default) = 15m/30m/1h/4h are aggregated from the stored 5m feed at
# read time; legacy = explicit emergency rollback to provider-direct serving
# (KIS caps a minute page at 120 rows, so 30m/1h/4h are truncated there).
# Seed the 5m baseline first: pnpm candle:baseline -- --apply (see README).
CANDLE_SERVING_MODE=database
CANDLE_SERVING_CURRENT_DB_FRESHNESS_MS=60000
CANDLE_SERVING_ON_DEMAND_REFRESH_ENABLED=true
CANDLE_SERVING_ON_DEMAND_REFRESH_MAX_DURATION_MS=15000
# 15 pages so one repair sweep covers the whole 15m/3d source window
# (3d + 4h padding ~= up to 4 KRX sessions ~= 13 KIS minute pages).
CANDLE_SERVING_ON_DEMAND_REFRESH_MAX_PAGES=15
CANDLE_SERVING_ON_DEMAND_REFRESH_MAX_ROWS=5000
CANDLE_SERVING_STALE_WAITER_MAX_WAIT_MS=500
# 4 days: must exceed the 15m tab's 3d + 4h source span so a cold asset can
# repair on demand; 14d/30d windows stay above it (baseline-seeded instead).
CANDLE_SERVING_ON_DEMAND_REPAIR_MAX_RANGE_MS=345600000
# How far confirmed sync coverage may lag the request clock before the window
# counts as unconfirmed. A checkpoint confirms coverage only up to its own
# finish time, so requiring coverage exactly to "now" would make every long
# window unservable one minute after a sync. Default: 1 day.
CANDLE_SERVING_COVERAGE_TAIL_TOLERANCE_MS=86400000
CANDLE_SERVING_DB_SMOKE=0

# Unit 3 live candle pipeline. Every gate is disabled by default. The KIS US
# stream is HDFSCNT0 delayed trade data and must remain explicitly opt-in.
CANDLE_LIVE_STREAMING_ENABLED=false
CANDLE_LIVE_KIS_ENABLED=false
CANDLE_LIVE_KIS_US_DELAYED_ENABLED=false
CANDLE_LIVE_BINANCE_ENABLED=false
CANDLE_LIVE_OWNER_LEASE_TTL_MS=30000
CANDLE_LIVE_OWNER_LEASE_RENEW_MS=10000
CANDLE_LIVE_RECONNECT_MIN_MS=1000
CANDLE_LIVE_RECONNECT_MAX_MS=30000
CANDLE_LIVE_FINALIZE_GRACE_MS=5000
CANDLE_LIVE_FINALIZER_INTERVAL_MS=1000
# Connection liveness (supervisor reconnect watchdog): close the provider
# socket only when NO frame of any kind (trade, ack, PINGPONG, WS ping)
# arrived within this window. Deliberately longer than trade staleness.
CANDLE_LIVE_CONNECTION_LIVENESS_TIMEOUT_MS=90000
# Trade freshness (readiness LIVE_PROVIDER_STALE): how old the last processed
# trade/kline event may be while the market can trade. Never closes sockets.
CANDLE_LIVE_TRADE_STALE_THRESHOLD_MS=30000
# DEPRECATED: CANDLE_LIVE_STALE_THRESHOLD_MS conflated the two settings above.
# It is only used as a fallback when a dedicated variable is unset; the
# dedicated variables always win. Invalid values still fail configuration.
# CANDLE_LIVE_STALE_THRESHOLD_MS=30000
CANDLE_LIVE_MAX_SUBSCRIPTIONS_PER_CLIENT=20
# Cap on ASSETS subscribed on one provider connection. Kept for backward
# compatibility and still enforced, but it is NOT the provider's real limit.
CANDLE_LIVE_MAX_PROVIDER_SUBSCRIPTIONS_PER_SHARD=200
# Cap on raw provider STREAMS on one connection — the unit Binance actually
# limits (1024 per connection). An asset costs ONE stream with the matcher off
# (`<symbol>@kline_5m`) and TWO with it on (`+ <symbol>@trade`, on the SAME
# socket), so an asset-count cap of 1024 would silently request 2048 streams
# and Binance would reject the whole SUBSCRIBE, leaving a connected socket that
# carries no market data at all. The effective asset budget is
# min(SUBSCRIPTIONS_PER_SHARD, floor(STREAMS_PER_SHARD / streams-per-asset)),
# assets beyond it are reported `capped` and fail limit-order readiness closed,
# and the actually-sent stream array is asserted against 1024 before SUBSCRIBE.
CANDLE_LIVE_MAX_PROVIDER_STREAMS_PER_SHARD=1024
CANDLE_LIVE_STATE_TTL_SECONDS=86400
CANDLE_LIVE_MAX_FUTURE_EVENT_SKEW_MS=10000
CANDLE_LIVE_WS_BACKPRESSURE_BYTES=1048576
# Old-generation / deferred bucket recovery (bounded queue, no SCAN).
CANDLE_LIVE_RECOVERY_MAX_BATCH=10
CANDLE_LIVE_RECOVERY_RETRY_MS=60000
# Live ingestion requires its reconciliation safety net. Production refuses
# to start with a live market enabled but its reconciliation disabled unless
# this explicit (exceptional, temporary) escape hatch is set.
LIVE_CANDLE_ALLOW_WITHOUT_RECONCILIATION=false

# REST canonical reconciliation. Market-specific flags also enable the Ops
# scheduler, but all defaults remain disabled.
CANDLE_RECONCILIATION_ENABLED=false
CANDLE_RECONCILIATION_KRX_ENABLED=false
CANDLE_RECONCILIATION_KRX_TIME=16:00
CANDLE_RECONCILIATION_KRX_GRACE_MINUTES=20
CANDLE_RECONCILIATION_US_ENABLED=false
CANDLE_RECONCILIATION_US_TIME=16:30
CANDLE_RECONCILIATION_US_GRACE_MINUTES=20
CANDLE_RECONCILIATION_CRYPTO_ENABLED=false
CANDLE_RECONCILIATION_CRYPTO_INTERVAL_SECONDS=300
CANDLE_RECONCILIATION_LOOKBACK_BUCKETS=24
CANDLE_RECONCILIATION_STARTUP_CATCH_UP_ENABLED=false
CANDLE_RECONCILIATION_MAX_CATCH_UP_HOURS=72
CANDLE_RECONCILIATION_MAX_ASSETS=200
CANDLE_RECONCILIATION_MAX_PAGES=10

# Versioned market calendar readiness coverage (defaults: current year
# through next year). Dates in years without a dataset are never assumed to
# be trading days; readiness reports MARKET_CALENDAR_COVERAGE_MISSING for
# missing years and MARKET_CALENDAR_PROVISIONAL for years whose dataset is
# not yet verified against the official exchange notice (e.g. KRX 2027 until
# the KRX year-end notice, expected ~Dec 2026, is published — then bump the
# dataset version and drop the -provisional suffix). If a 2026 release does
# not require 2027, set MARKET_CALENDAR_REQUIRED_THROUGH_YEAR=2026: this
# narrows the REQUIREMENT — never use env vars to present provisional data
# as audited.
# MARKET_CALENDAR_REQUIRED_FROM_YEAR=2026
# MARKET_CALENDAR_REQUIRED_THROUGH_YEAR=2027

# Fixture/live smokes are never enabled by the application itself.
CANDLE_LIVE_PIPELINE_SMOKE=0
CANDLE_LIVE_REDIS_SMOKE=0
# Release fixture smoke (real PostgreSQL+Redis, fixture providers only):
#   CANDLE_PIPELINE_RELEASE_FIXTURE_SMOKE=1 pnpm run smoke:candle-fixture
CANDLE_PIPELINE_RELEASE_FIXTURE_SMOKE=0
# Long real-provider smokes (scripts/candle-live-smoke.ts); see
# docs/candle-live-operations.md for the runbook.
CANDLE_LIVE_LONG_SMOKE=0
KIS_LIVE_CANDLE_SMOKE=0
BINANCE_LIVE_CANDLE_SMOKE=0
# Smoke commit traceability: every smoke artifact records gitCommit/gitBranch/
# gitDirty. A smoke aborts when no commit SHA can be resolved, and refuses a
# dirty working tree by default (dirty runs are never release validation).
# SMOKE_GIT_COMMIT=<full 40-char SHA override when git is unavailable>
# SMOKE_ALLOW_DIRTY=1   # development-only escape hatch; artifact keeps gitDirty=true

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d

PROVIDER_INGESTION_ENABLED=false
PROVIDER_INGESTION_MAX_SNAPSHOTS=500
PROVIDER_HTTP_TIMEOUT_MS=
PROVIDER_RAW_PAYLOAD_MAX_BYTES=

EXCHANGE_RATE_API_ENABLED=
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_BASE_URL=

KOREA_EXIM_EXCHANGE_ENABLED=false
KOREA_EXIM_EXCHANGE_AUTH_KEY=
KOREA_EXIM_EXCHANGE_BASE_URL=https://oapi.koreaexim.go.kr
KOREA_EXIM_EXCHANGE_DATA=AP01
KOREA_EXIM_EXCHANGE_LOOKBACK_DAYS=7

# BINANCE_REST_BASE_URL defaults to https://api.binance.com when blank.
# The fixed 100-symbol crypto Spot universe is the single source of truth in code
# (src/providers/binance/binance-fixed-asset-universe.ts, BINANCE_FIXED_SYMBOLS);
# register those assets with `pnpm dev:seed-binance-universe -- --apply` or
# `pnpm dev:recover-local-data -- --apply`.
#
# How BINANCE_CRYPTO_SYMBOLS is used by each price path:
#   1. REST / manual ingestion (dev-run-provider-ingestions, operator triggers):
#      resolves targets from SCHEDULER_PROVIDER_TARGET_SOURCE=active_assets or merged
#      (default merged), i.e. the registered active DB assets — NOT this env var.
#   2. General Binance ticker WebSocket (BINANCE_WEBSOCKET_STREAMING_ENABLED=true):
#      subscribes ProviderConfigService.binance.symbols. When this var is unset it
#      falls back to the fixed 100 symbols, so all 100 coins stream + write snapshots.
#   3. Live candle Binance WebSocket (CANDLE_LIVE_STREAMING_ENABLED=true +
#      CANDLE_LIVE_BINANCE_ENABLED=true): subscribes the active crypto assets read
#      from the DB (kline_5m + ticker) and keeps writing asset_price_snapshots.
# Setting the value below pins the general ticker WebSocket to exactly that list.
BINANCE_PUBLIC_MARKET_DATA_ENABLED=
BINANCE_REST_BASE_URL=
BINANCE_WS_MARKET_DATA_BASE_URL=
BINANCE_CRYPTO_SYMBOLS=
BINANCE_CRYPTO_USDT_AS_USD_EQUIVALENT=
BINANCE_WEBSOCKET_STREAMING_ENABLED=false
BINANCE_WEBSOCKET_STREAMING_RECONNECT_MIN_MS=1000
BINANCE_WEBSOCKET_STREAMING_RECONNECT_MAX_MS=30000
BINANCE_WEBSOCKET_STREAMING_HEARTBEAT_TIMEOUT_MS=60000
BINANCE_WS_SNAPSHOT_THROTTLE_MS=5000
# NEW WS ticker rows keep only the identity, price, time and 24 h fields of the
# frame (q stays for the asset-list turnover sort) and no repeated note. Price,
# source and both times are columns either way. Default false; irreversible per row.
BINANCE_WS_RAW_SLIM_ENABLED=false
# Shared Spot + USDⓈ-M REST weight budget per Redis UTC minute: 20..1200,
# 600 when unset. Identical on every instance sharing Redis. Set 1200 only
# after deploying code that accepts it (older code accepts at most 600).
# See docs/binance-rest-limits.md.
# BINANCE_REST_WEIGHT_BUDGET_PER_MINUTE=1200

KIS_MARKET_DATA_ENABLED=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_REST_BASE_URL=
KIS_RATE_LIMIT_ENABLED=true
KIS_API_ENVIRONMENT=real
# Defaults: 125 for real, 1000 for virtual. OAuth is always at least 1000.
KIS_REST_MIN_INTERVAL_MS=125
KIS_OAUTH_MIN_INTERVAL_MS=1000
KIS_RATE_LIMIT_MAX_WAIT_MS=30000
KIS_RATE_LIMIT_MAX_QUEUE_SIZE=500
KIS_WS_BASE_URL=
KIS_MAX_WATCHLIST_SIZE=
# Retired for new collection; existing domestic assets are resolved by KOSCOM.
KIS_DOMESTIC_SYMBOLS=
KIS_US_SYMBOLS=
KIS_WS_CUSTTYPE=
KIS_WS_DOMESTIC_TR_ID=
KIS_WS_OVERSEAS_DELAYED_TR_ID=
KIS_WS_SNAPSHOT_THROTTLE_MS=
KIS_WS_MAX_RUNTIME_MS=
KIS_WS_ALLOW_US_DELAYED=
KIS_WEBSOCKET_STREAMING_ENABLED=false
KIS_WEBSOCKET_STREAMING_RECONNECT_MIN_MS=1000
KIS_WEBSOCKET_STREAMING_RECONNECT_MAX_MS=30000
KIS_WEBSOCKET_STREAMING_HEARTBEAT_TIMEOUT_MS=60000
# When KIS ingestion is enabled, backend startup performs one best-effort REST
# current-price gap fill only after today's completed KRX session is missing.
# This has no separate flag and never changes WebSocket into REST polling.
KIS_PRICE_INGESTION_MODE=websocket_trade

ENABLE_PROVIDER_LIVE_SMOKE=
KIS_DOMESTIC_CANDLE_LIVE_SMOKE=0
KIS_DOMESTIC_CANDLE_SMOKE_SYMBOL=005930
KIS_DOMESTIC_CANDLE_SMOKE_MARKET=J
KIS_US_CANDLE_LIVE_SMOKE=0
KIS_US_CANDLE_SMOKE_SYMBOL=AAPL
KIS_US_CANDLE_SMOKE_MARKET=NAS

# Tiingo US-equity provider (docs/tiingo-us-equity-official.md). Disabled by
# default. Two modes:
#  - TIINGO_TRIAL_MODE=true (default): the display-only, memory-only TRIAL —
#    never stored or used for orders, valuation, ranking or settlement; max 5
#    explicit symbols; refused on a production-like runtime (NODE_ENV=production
#    or Render) unless TIINGO_ALLOW_PRODUCTION_TRIAL=true.
#  - TIINGO_TRIAL_MODE=false: the OFFICIAL (licensed) mode — one collector
#    (Redis lease) stores regular-session reference prices
#    (`tiingo_us_reference_price`, ≤ 1 row / symbol / TIINGO_SNAPSHOT_THROTTLE_MS)
#    and fans them out; the symbol list defaults to the fixed 25 US stocks
#    (max 100). Stored data becomes FINANCIAL only with
#    US_STOCK_PRICE_PROVIDER=tiingo below.
# The token stays backend-only; never commit a real value.
TIINGO_ENABLED=false
TIINGO_API_TOKEN=
# Trial: explicit test universe (max 5). Official: empty = the fixed 25.
TIINGO_ALLOWED_SYMBOLS=
TIINGO_TRIAL_MODE=true
# Official mode: minimum spacing of stored snapshots per symbol (1000..60000).
TIINGO_SNAPSHOT_THROTTLE_MS=5000
TIINGO_ALLOW_PRODUCTION_TRIAL=false
TIINGO_REST_BASE_URL=https://api.tiingo.com
TIINGO_WS_URL=wss://api.tiingo.com/equity/intraday
# thresholdLevel 6 (reference price) and 4 (liquidity estimate) streams.
TIINGO_WS_ENABLED=true
TIINGO_WS_LIQUIDITY_ENABLED=true
TIINGO_HTTP_TIMEOUT_MS=5000
TIINGO_HTTP_MAX_RETRIES=2
TIINGO_HTTP_MAX_RESPONSE_BYTES=4000000
# Local request budget, global and per symbol. Leave the global limits unset
# so the mode default applies (trial 30/min and 600/h, official 120/min and
# 3000/h — far below the contract's 30,000/h): a trial value set explicitly
# would starve the official candle sync and the US LOC close reads.
# TIINGO_REST_REQUESTS_PER_MINUTE=
TIINGO_REST_SYMBOL_REQUESTS_PER_MINUTE=20
# TIINGO_REST_REQUESTS_PER_HOUR=
TIINGO_WS_RECONNECT_MIN_MS=1000
TIINGO_WS_RECONNECT_MAX_MS=60000
# Tiingo sends a heartbeat every 120 s: dead after 2.5 intervals.
TIINGO_WS_HEARTBEAT_TIMEOUT_MS=300000
TIINGO_WS_SUBSCRIBE_TIMEOUT_MS=10000
# Opt-in real checks (read-only, print no prices): pnpm smoke:tiingo-trial
# (one symbol) and pnpm smoke:tiingo-official (TIINGO_SMOKE_SYMBOLS or the 25).
TIINGO_LIVE_SMOKE=0
TIINGO_SMOKE_SYMBOL=AAPL
TIINGO_SMOKE_SYMBOLS=
TIINGO_SMOKE_WS_SECONDS=30
# The US stocks' single FINANCIAL price source (display, quote, execute,
# valuation, settlement, conditional triggers, candles, change rate): kis
# (default) | tiingo. tiingo requires the official mode above; there is no
# KIS or admin_manual stand-in. Switching is the runbook's last step.
US_STOCK_PRICE_PROVIDER=kis
# Market data a signed-out visitor ("로그인 없이 둘러보기") may read through
# GET /api/v1/assets (list/search), /assets/:assetId and /assets/:assetId/candles
# (domestic_stock, us_stock, crypto), and GET /api/v1/futures/instruments,
# /futures/instruments/:id/candles and /fx/rates/current (crypto_futures).
# Empty (default) = every market (provider display rights confirmed by the
# operator, 2026-10-30). A comma-separated list of domestic_stock, us_stock,
# crypto, crypto_futures narrows it; `none` turns guest market data off (every
# anonymous read keeps the 401). Unknown values refuse to boot.
GUEST_MARKET_DATA_ASSET_TYPES=
# Opt-in candle sync smokes: DB fixture smoke (needs PostgreSQL + Redis) and
# small bounded live-provider smokes. Never enabled by default.
MARKET_CANDLE_SYNC_DB_SMOKE=0
KIS_PERIOD_CANDLE_LIVE_SMOKE=0
BINANCE_CANDLE_LIVE_SMOKE=0
BINANCE_CANDLE_SMOKE_SYMBOL=BTCUSDT

# Checkpointed market candle sync (manual Ops job market_candle_sync; no
# scheduler in this phase). Budgets are per asset/feed run; the lock renewal
# interval must stay below the lock TTL. KIS-backed assets always sync one at
# a time regardless of MARKET_CANDLE_SYNC_ASSET_CONCURRENCY (which bounds
# crypto fan-out and is capped at 8).
MARKET_CANDLE_SYNC_MAX_PAGES=300
MARKET_CANDLE_SYNC_MAX_ROWS=50000
MARKET_CANDLE_SYNC_MAX_DURATION_MS=180000
MARKET_CANDLE_SYNC_ASSET_CONCURRENCY=2
MARKET_CANDLE_SYNC_INCREMENTAL_OVERLAP_MINUTES=120
MARKET_CANDLE_SYNC_LOCK_TTL_SECONDS=120
MARKET_CANDLE_SYNC_LOCK_RENEW_SECONDS=40

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Seoul
SCHEDULER_PROVIDER_FX_ENABLED=false
SCHEDULER_PROVIDER_BINANCE_ENABLED=false
SCHEDULER_PROVIDER_KIS_ENABLED=false
SCHEDULER_DAILY_SNAPSHOT_ENABLED=false
# Daily flag enables season + general on the existing shared tick.
# Optional filter; blank selects all currently active seasons.
SCHEDULER_DAILY_SNAPSHOT_SEASON_ID=
SCHEDULER_RANKING_ENABLED=false
SCHEDULER_SEASON_LIFECYCLE_ENABLED=false
SCHEDULER_SETTLEMENT_ENABLED=false
SCHEDULER_REWARD_MARKER_ENABLED=false
SCHEDULER_MARKET_CANDLE_RETENTION_ENABLED=false
# Closed 5m candles older than this are pruned (code default 45, minimum 31;
# KRX central collection refuses to start below 45).
MARKET_CANDLE_5M_RETENTION_DAYS=45
# Completed long-range 4h history (market_candles '4h' + futures_market_candles),
# pruned by the same retention job with its own cutoff. Minimum 150.
MARKET_CANDLE_4H_RETENTION_DAYS=180
MARKET_CANDLE_RETENTION_BATCH_SIZE=5000
SCHEDULER_MARKET_CANDLE_RETENTION_HOUR=4
SCHEDULER_MARKET_CANDLE_RETENTION_MINUTE=0
SCHEDULER_MARKET_CANDLE_RETENTION_RUN_ON_STARTUP=false
# Scheduled incremental upkeep of the stored candle feeds (the 5m baseline the
# 15m-4h charts aggregate from, plus 1d/1w). Runs the same checkpointed
# market_candle_sync Ops job the operator API triggers, mode=incremental.
# Seed once with `pnpm candle:baseline -- --apply`; this keeps it fresh.
SCHEDULER_MARKET_CANDLE_SYNC_ENABLED=false
SCHEDULER_MARKET_CANDLE_SYNC_INTERVAL_SECONDS=600
# Empty keeps all active supported assets; otherwise, comma-separated Asset UUIDs only.
SCHEDULER_MARKET_CANDLE_SYNC_ASSET_IDS=
# Long-range 4h upkeep (docs/long-range-4h-candles.md). Opt-in; the initial
# backfill is `pnpm candle:long-backfill`, never automatic.
SCHEDULER_MARKET_CANDLE_LONG_SYNC_ENABLED=false
SCHEDULER_MARKET_CANDLE_LONG_SYNC_INTERVAL_SECONDS=900
# Subset of spot,krx,us (default spot,krx). `us` synthesizes US 4h rows from
# stored Tiingo 5m (no provider call) and runs only with
# US_STOCK_PRICE_PROVIDER=tiingo.
SCHEDULER_MARKET_CANDLE_LONG_SYNC_MARKETS=spot,krx
# USDⓈ-M contract 4h klines incl. the provisional bucket (futures chart).
SCHEDULER_FUTURES_CANDLE_SYNC_ENABLED=false
SCHEDULER_FUTURES_CANDLE_SYNC_INTERVAL_SECONDS=60
# Futures chart 5m/15m/30m/1h/1d: the contract's native klines read on demand
# through one shared server cache (docs/futures-chart-timeframes.md). Upper
# bound of those provider calls per minute per process (1..600, default 60).
FUTURES_CANDLE_PROVIDER_MAX_CALLS_PER_MINUTE=60
SCHEDULER_TICK_INTERVAL_MS=60000
SCHEDULER_PROVIDER_FX_INTERVAL_SECONDS=3600
SCHEDULER_PROVIDER_BINANCE_INTERVAL_SECONDS=60
SCHEDULER_PROVIDER_KIS_INTERVAL_SECONDS=60
SCHEDULER_PROVIDER_INGESTION_RUN_ON_STARTUP=false
SCHEDULER_PROVIDER_KIS_MAX_SNAPSHOTS=500
SCHEDULER_LOCK_TTL_SECONDS=600
SCHEDULER_MAX_ATTEMPTS=1

# Production ranking scheduler example.
# Defaults above stay disabled; copy these non-secret values to the deployment env
# only when automatic current ranking refresh and scheduled equity snapshots are intended.
# SCHEDULER_ENABLED=true
# SCHEDULER_RANKING_ENABLED=true
# SCHEDULER_TICK_INTERVAL_MS=60000
# SCHEDULER_LOCK_TTL_SECONDS=600
# SCHEDULER_MAX_ATTEMPTS=1
#
# Minimal alternative accepted by the backend:
# ENABLE_RANKING_SCHEDULER=true
#
# Provider ingestion and reward marker scheduler flags are separate gates.

ENABLE_RANKING_SCHEDULER=false
ENABLE_PROVIDER_KIS_SCHEDULER=false
RANKING_REFRESH_INTERVAL_SECONDS=60
ENABLE_SEASON_LIFECYCLE_SCHEDULER=false
ENABLE_SEASON_SETTLEMENT_SCHEDULER=false
SEASON_SETTLEMENT_INTERVAL_SECONDS=60

# Limit-buy registration gate. Default false. Enabled users can register
# GTC-style limit buys that reserve cash. Registration completes against
# PostgreSQL alone. Cancel and lifecycle cleanup work while the flag is false.
#
# STRICTLY VALIDATED AT STARTUP. Accepted values are exactly true / false /
# 1 / 0, trimmed and case-insensitive (TRUE and False are fine). Omitting the
# variable entirely means false. ANY other value — yes, enabled, tru, or an
# explicitly empty value — aborts bootstrap with an "Invalid environment
# configuration" error instead of being silently read as off, because a flag
# an operator believes is on but is quietly off is the dangerous failure.
LIMIT_ORDER_ENABLED=false

# Synthetic USD perpetuals: implementation does not enable production trading.
# Enablement requires the F3/F3.1 release checks and a separate operator action.
# Legacy flag is used only when FUTURES_TRADING_MODE is absent.
FUTURES_TRADING_ENABLED=false
FUTURES_TRADING_MODE=DISABLED
# User SL/TP/OCO and attached Spot Limit entry; operational activation is separate.
# Existing OCO groups trigger/fill under this flag; NEW groups are retired below.
CONDITIONAL_ORDERS_ENABLED=false
# New whole-position OCO groups (POST /protections, attachedProtection on a Spot
# BUY Limit or Futures limit entry) are retired (2026-10-16): new TP/SL uses the
# independent settings and entry plans. Strict true/false; keep false in
# production (true only for legacy compatibility tests).
LEGACY_OCO_REGISTRATION_ENABLED=false
# Conditional BUY watches (KRX stocks + crypto Spot). Independent of
# CONDITIONAL_ORDERS_ENABLED: enabling protection never exposes this feature.
# Strict true/false. Off: no new watches/triggers; read/cancel/lifecycle
# cleanup keep working. Limit execution also needs LIMIT_ORDER_ENABLED and
# SCHEDULER_LIMIT_ORDER_MATCHING_ENABLED (the existing matcher fills it).
CONDITIONAL_BUY_ORDERS_ENABLED=false
# Futures conditional entries (docs/futures-conditional-entry-contract.md): a
# reservation-free watch on Futures Last that opens ONE new position (market
# open or Futures limit entry) when triggered. Separate from position TP/SL
# (CONDITIONAL_ORDERS_ENABLED). Strict true/false. Off: no new entries or
# triggers; list, cancel and lifecycle cleanup keep working. Needs
# FUTURES_TRADING_MODE=ENABLED to register and trigger.
FUTURES_CONDITIONAL_ENTRY_ENABLED=false
# Independent Futures stop-loss/take-profit settings (partial, reduce-only, at
# Futures Last) and stop-loss/take-profit plans on pending Futures entries
# (docs/independent-tp-sl-entry-plans-contract.md). Strict true/false. Off: no
# new settings/plans or triggers; list, cancel, lifecycle cleanup and a plan's
# activation at its entry's fill keep working. Registration and triggering are
# refused/paused only while FUTURES_TRADING_MODE=DISABLED.
FUTURES_TP_SL_ORDERS_ENABLED=false
# KRX Limit-on-Close BUY registration. Strict true/false. Off blocks only NEW
# LOC orders; accepted ones still settle or release on final close evidence.
# Needs KOSCOM dated close history (KOSCOM_API_KEY etc.) — without it every
# LOC expires and releases at the evidence deadline (fail-closed).
LOC_ORDERS_ENABLED=false
# Close-evidence timing (seconds, strictly validated). First dated close
# request no earlier than close + MIN_DELAY (300..7200), finality = an
# identical observation CONFIRM later (60..3600), release at close + DEADLINE
# (1800..43200; must cover MIN_DELAY + 2 × CONFIRM).
LOC_CLOSE_EVIDENCE_MIN_DELAY_SECONDS=1200
LOC_CLOSE_EVIDENCE_CONFIRM_SECONDS=300
LOC_CLOSE_EVIDENCE_DEADLINE_SECONDS=10800
# KRX Limit-on-Close SELL registration (its own flag; the BUY flag never opens
# it). Same evidence, timing and release rules.
LOC_SELL_ORDERS_ENABLED=false
# US Limit-on-Close BUY / SELL registration (2026-10-17), independent of the
# KRX flags. Require US_STOCK_PRICE_PROVIDER=tiingo (startup error otherwise).
# Evidence = Tiingo end-of-day RAW close of the session date; New York times.
LOC_US_ORDERS_ENABLED=false
LOC_US_SELL_ORDERS_ENABLED=false
# First observation no earlier than this New York time (21:10..22:50), an
# identical second observation ≥ CONFIRM later (300..3600 s) is final, no final
# close by the DEADLINE New York time (21:10..23:59) → expire and release.
LOC_US_CLOSE_EVIDENCE_EARLIEST_ET=21:10
LOC_US_CLOSE_EVIDENCE_CONFIRM_SECONDS=300
LOC_US_CLOSE_EVIDENCE_DEADLINE_ET=23:00
# ENABLED requires BOTH flags below (and Futures Last ingestion). REDUCE_ONLY
# permits only reduce/close and requires Futures Last ingestion.
# Risk is independent of user mode: keep protection running for existing positions.
# Disable risk only as a separate emergency action. No provider credentials needed.
FUTURES_RISK_ENGINE_ENABLED=false
FUTURES_MARK_INGESTION_ENABLED=false
# Unreferenced Mark retention follows ingestion when this override is absent.
# Latest instrument/source evidence and financial FK references are preserved.
# FUTURES_MARK_RETENTION_ENABLED=true
FUTURES_MARK_RETENTION_HOURS=24
FUTURES_MARK_RETENTION_BATCH_SIZE=1000
# Futures Last Price (USDⓈ-M perpetual last trade) prices every Futures fill,
# TP/SL trigger and Season final exit. Follows FUTURES_MARK_INGESTION_ENABLED when
# absent. ENABLED and REDUCE_ONLY both require it (startup validation). Keep it
# running whenever open Futures positions exist, even in DISABLED mode.
# FUTURES_LAST_PRICE_INGESTION_ENABLED=true
# Display-only USDⓈ-M order book (/public depth10@500ms) and 24h statistics
# (/market @ticker) on their own sockets; no REST weight. Follows
# FUTURES_LAST_PRICE_INGESTION_ENABLED when absent.
# FUTURES_MARKET_DATA_STREAMING_ENABLED=true
# Unreferenced Last observations; executions, Season pins, triggers, Season end
# windows and the latest row per instrument/source are always preserved.
# FUTURES_LAST_PRICE_RETENTION_ENABLED=true
FUTURES_LAST_PRICE_RETENTION_HOURS=24
FUTURES_LAST_PRICE_RETENTION_BATCH_SIZE=1000

# Database storage sampler (pg_database_size every 5 min, no table reads).
# Strict true/false; default false. With the provisioned disk size in decimal GB
# (Render "50 GB" → 50) /readiness reports DB_STORAGE_WARNING (60 %),
# DB_STORAGE_ACTION_REQUIRED (80 %), DB_STORAGE_CRITICAL (90 %) and
# DB_STORAGE_RUNWAY_SHORT. Update the capacity after every disk resize.
# See docs/database-operations-monitoring.md for alert delivery.
DATABASE_STORAGE_MONITOR_ENABLED=false
# DATABASE_STORAGE_CAPACITY_GB=50

# Asset price snapshot retention (asset_price_snapshots), product policy 14 days
# (never fewer). Strict true/false, default false: enabling it in production
# starts deleting the existing backlog at the capped pace, an approved step.
# Kept regardless of age: rows any financial record references, each
# asset/source/local date's last row, the 20 newest per source before every
# Season end, admin_manual rows and rows created in the last 2 days.
# Every 5 min; per run at most MAX_BATCHES × BATCH_SIZE rows and 60 s.
# See docs/database-operations-monitoring.md.
ASSET_PRICE_SNAPSHOT_RETENTION_ENABLED=false
ASSET_PRICE_SNAPSHOT_RETENTION_DAYS=14
ASSET_PRICE_SNAPSHOT_RETENTION_BATCH_SIZE=1000
ASSET_PRICE_SNAPSHOT_RETENTION_MAX_BATCHES=20

# Crypto order-book history: one display-only 10-level book per Binance Spot
# asset / USDⓈ-M contract and UTC minute, kept 14 days
# (docs/crypto-order-book-history-contract.md). Strict true/false, default false:
# at 100 + 100 products it adds up to 288,000 rows a day, so enabling it in
# production follows the disk decision. Retention (every 5 min, ≤ 20,000 rows a
# run) follows recording unless set; set it alone to drain after recording stops.
# Neither flag changes the WebSocket streams or the realtime order-book fanout.
CRYPTO_ORDER_BOOK_HISTORY_ENABLED=false
# CRYPTO_ORDER_BOOK_RETENTION_ENABLED=

# Push notifications (docs/push-notifications-contract.md). Strict true/false,
# default false: the worker derives notifications from committed rows (fills,
# liquidations, final failures, friend requests, published important notices,
# Season results / ending) and sends them through the Expo Push Service.
# DRY_RUN=true still derives them but marks them skipped instead of sending.
# Device/preference APIs work with the worker off. EXPO_ACCESS_TOKEN only when
# "enhanced push security" is on for the Expo project (never commit a value).
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_NOTIFICATIONS_DRY_RUN=false
PUSH_NOTIFICATIONS_INTERVAL_MS=10000
# EXPO_ACCESS_TOKEN=

# Scheduler-based automatic limit-order matching (paths A + B). Default false.
# Runs on a DEDICATED interval (not the shared 60s tick), single-instance via
# the PostgreSQL OpsJobLock — never Redis. Path A fills a submitted limit buy
# at a fresh provider snapshot price when it reaches the limit; path B fills at
# the ORDER's limit price off a closed 5-minute candle whose low touched the
# limit. Registration keeps working with this off; existing submitted orders
# then simply never auto-fill.
SCHEDULER_LIMIT_ORDER_MATCHING_ENABLED=false
# Matching cadence. STRICTLY VALIDATED: 1000..5000 ms. The ceiling is half the
# 10s provider execute-freshness window, so a snapshot the matcher accepts can
# never age past freshness before the fill commits.
LIMIT_ORDER_MATCHING_INTERVAL_MS=5000
# Fills per matching cycle; the rest roll to the next cycle (oldest first).
LIMIT_ORDER_MATCH_BATCH_SIZE=200
# Path-B lookback: closed candles older than this are never used (no outage
# backfill / retroactive fill). STRICTLY VALIDATED: 300000..86400000 ms.
LIMIT_ORDER_CANDLE_LOOKBACK_MS=900000
#
# Setting SCHEDULER_LIMIT_ORDER_MATCHING_ENABLED=true while LIMIT_ORDER_ENABLED
# =false is allowed but logs a startup WARNING: no new limit orders can be
# registered, yet already-submitted ones keep auto-filling (a "drain" state).
#
# Opt-in switch for the limit-order PostgreSQL integration suites
# (reservation atomicity, create-vs-exclusion / create-vs-season-end races,
# post-lock transaction-time boundaries, no-Redis registration).
# Unset, those specs skip so `pnpm test` needs no database. Set to 1 with a
# migrated DATABASE_URL to run them:
#   LIMIT_ORDER_RESERVATION_DB_INTEGRATION=1 pnpm exec jest src/orders/limit-order-create-race.integration.spec.ts
# LIMIT_ORDER_RESERVATION_DB_INTEGRATION=1
#
# Idempotent-replay suite for committed limit creates (PostgreSQL only):
#   LIMIT_ORDER_IDEMPOTENT_REPLAY_INTEGRATION=1 pnpm exec jest src/orders/limit-order-idempotent-replay.integration.spec.ts
# LIMIT_ORDER_IDEMPOTENT_REPLAY_INTEGRATION=1
#
# Scheduler matching suite (paths A/B: fill price, pinned fee, partial-candle
# exclusion, cancel-vs-fill, ended season, evidence isolation). PostgreSQL only:
#   LIMIT_ORDER_MATCHING_DB_INTEGRATION=1 pnpm exec jest src/orders/limit-order-matching.integration.spec.ts
# LIMIT_ORDER_MATCHING_DB_INTEGRATION=1
# General-mode virtual-trading fee. Independent of Season.tradeFeeRate.
# Default when omitted: 0.001000 (0.1%). Range: 0..1, scale <= 6.
GENERAL_TRADE_FEE_RATE=0.001000
# General-mode virtual FX fee. Independent of Season.fxFeeRate and
# GENERAL_TRADE_FEE_RATE. Default when omitted: 0.001000 (0.1%).
GENERAL_FX_FEE_RATE=0.001000
# Optional managed profile image storage: set ALL six or leave ALL blank.
# Credentials stay backend-only. Use a dedicated bucket/public CDN for profile-images/*.
PROFILE_IMAGE_STORAGE_ENDPOINT=
PROFILE_IMAGE_STORAGE_REGION=
PROFILE_IMAGE_STORAGE_BUCKET=
PROFILE_IMAGE_STORAGE_ACCESS_KEY_ID=
PROFILE_IMAGE_STORAGE_SECRET_ACCESS_KEY=
PROFILE_IMAGE_PUBLIC_BASE_URL=

# Domestic stock data: KOSCOM Open API v3 (backend only).
# See docs/koscom-market-data.md. Global PROVIDER_INGESTION_ENABLED must be true.
KOSCOM_API_KEY=
KOSCOM_BASE_URL=https://oap.k-mydata.org
KOSCOM_MARKET_DATA_ENABLED=true
# Enable only after actual response/clock/adjustment verification.
KOSCOM_POLLING_ENABLED=false
KOSCOM_POLL_INTERVAL_MS=3000
KOSCOM_HTTP_TIMEOUT_MS=5000
KOSCOM_MAX_CONCURRENCY=2
KOSCOM_MIN_REQUEST_INTERVAL_MS=200
# The 10-level order book is collected every price cycle (default true).
KOSCOM_ORDERBOOK_COLLECTION_ENABLED=true
# NEW price rows keep only the audited raw fields (code, price, clocks, change,
# turnover, top of book). Default false; irreversible per row.
KOSCOM_PRICE_RAW_SLIM_ENABLED=false

# Auth email (backend only). All three required together; all blank disables
# delivery, but signup still requires proof. Generate a separate random secret.
RESEND_API_KEY=
EMAIL_FROM=
# When enabled: EMAIL_FROM="Trading Class <admin@nanghwa.com>"
EMAIL_VERIFICATION_SECRET=
# Set only after verifying ingress forwarding/trust topology (0 = socket IP).
AUTH_TRUST_PROXY_HOPS=0

# Data retention (docs/data-retention.md). On by default with the product
# periods below; nothing needs to be set. Hourly, 500 rows per table and batch
# (backlog: up to 10 batches, then again a minute later). Deletion is
# irreversible: the first run removes every row already past its period.
# DATA_RETENTION_CLEANUP_ENABLED=false is the emergency stop (strict true/false).
# Days are strict integers; an out-of-range value refuses to boot.
# Refresh sessions (IP/user agent), counted from expiry or revocation: 30–365.
# AUTH_SESSION_RETENTION_DAYS=90
# Operator audit logs: at least 365 (legal minimum); 730 near 50,000 members.
# OPERATOR_AUDIT_LOG_RETENTION_DAYS=365
# Support inquiries + answers, from the answer (unanswered: filing): 30–3650.
# INQUIRY_RETENTION_DAYS=1095
# DATA_RETENTION_CLEANUP_ENABLED=true

# Rewarded ads for GENERAL accounts: the KRW top-up and the general-account
# reset (docs/general-account-and-ad-rewards-api-contract.md). Disabled by
# default. Leave AD_REWARD_ENABLED=false until a real provider adapter is
# registered in AdRewardsModule: with no adapter every claim/reset is 503
# AD_REWARD_PROVIDER_UNAVAILABLE. With ENABLED=true every value below is
# REQUIRED (boot is refused otherwise). Product values (2026-10-20): 5,000,000
# KRW per ad; limits/cooldown are operating choices — e.g. 3 per day.
AD_REWARD_ENABLED=false
# AD_REWARD_PROVIDER=<registered adapter key>
# AD_REWARD_AMOUNT_KRW=5000000
# AD_REWARD_DAILY_MAX_COUNT=3
# AD_REWARD_DAILY_MAX_AMOUNT_KRW=15000000
# AD_REWARD_COOLDOWN_SECONDS=60
# AD_REWARD_DAY_TIME_ZONE=Asia/Seoul
